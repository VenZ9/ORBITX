<?xml version="1.0" encoding="utf-8"?>
<!--
     SETTINGS . the fast-client row   (was: a rounded card with elevation)

     This is one row of the settings list, and it used to be a CARD: a
     ConstraintLayout wrapping a CardView with a 14dp radius, a 4dp elevation and
     a hardcoded fill, holding a 28dp glyph, a bold title, a subtitle and a
     trailing switch, then a separate bold line below for the active version.

     A card inside a list of cards inside a page is three levels of container to
     say one thing. It is now a FLUSH ROW, the same row every other setting uses:

         [glyph]  Fast client                                  [ switch ]
                  Enable fast client acceleration

     and the version readout is a MONO STATUS LINE underneath, aligned to the
     title rather than to the card edge. The card is gone, so this row lines up
     with every neighbouring row instead of being inset by its own gutters,
     which is the whole reason the old list looked accidental.

     The switch keeps its id and its tint selectors, because the fragment binds
     it directly and the tint is what carries the checked state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/card_fastclient_section"
        style="@style/OdRow.Tall"
        android:layout_width="match_parent">

        <FrameLayout
            android:layout_width="@dimen/od_well_w"
            android:layout_height="@dimen/od_well_w"
            android:background="@drawable/od_well">

            <ImageView
                android:id="@+id/iv_fastclient_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="FastClient"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu_settings"
                app:tint="@color/od_accent_bright" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fastclient_title"
                style="@style/OdText.TitleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast client"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tv_fastclient_subtitle"
                style="@style/OdText.BodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Enable fast client acceleration"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_fastclient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />
    </LinearLayout>

    <View style="@style/OdRow.Divider" />

    <!-- Active-version readout. A status line, not a bold caption: mono, inset
         to the title's left edge, and dim until a version is actually live. -->
    <TextView
        android:id="@+id/tv_fastclient_version_info"
        style="@style/OdText.MonoS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="58dp"
        android:paddingTop="@dimen/od_space_2"
        android:paddingEnd="@dimen/od_gutter"
        android:paddingBottom="@dimen/od_space_3"
        android:text="FastClient v1.6.2 - active"
        android:visibility="gone"
        tools:ignore="HardcodedText" />
</LinearLayout>
