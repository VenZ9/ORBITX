<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — ACCOUNT / SIGN-IN  (was: three big method cards)

  THE STRUCTURAL CHANGE

  The screen offered its three sign-in methods as large vertical CARDS, each one
  a coloured glyph tile stacked over a title and a paragraph. Three cards is a
  storefront choice: it dramatises a three-way choice and costs the whole screen
  to do it, so the footnote and the method details were pushed below the fold.

  A desktop sign-in dialog lists its methods. This is now a LIST OF ROWS on a
  single panel:

      +--------------------------------------------+
      |  (o) MICROSOFT  [RECOMMENDED]           >  |  row 1
      |      Servers - skins - capes               |
      |  ----------------------------------------  |  hairline
      |  ( ) ELY.BY                             >  |  row 2
      |      Free skins - most servers             |
      |  ----------------------------------------  |
      |  ( ) LOCAL                              >  |  row 3
      |      Offline / LAN only                    |
      +--------------------------------------------+

  - each method is a 56dp two-line row, hairline-separated, full-bleed hit area
  - the decorative colour glyph tile becomes a small radio SCOPE MARK, so the
    rows read as one exclusive choice rather than as three destinations
  - a trailing chevron states that the row advances
  - the footnote sits inside the panel, not below the fold

  Ids preserved (LauncherActivity/MicrosoftLoginFragment bind all of them):
  auth_aura, auth_header, auth_title, card_auth_container,
  button_microsoft_authentication, button_elyby_authentication,
  button_local_authentication, auth_footnote.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_pane">

    <!-- decorative aura, retired to a flat accent bar so the panel can lead -->
    <View
        android:id="@+id/auth_aura"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:background="@color/od_accent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/od_space_6"
            android:paddingTop="@dimen/od_space_8"
            android:paddingEnd="@dimen/od_space_6"
            android:paddingBottom="@dimen/od_space_6">

            <!-- -- header: the app marks itself, then states the task -- -->
            <LinearLayout
                android:id="@+id/auth_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/orbitx_mark" />

                <TextView
                    style="@style/OdText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_3"
                    android:text="ORBITX - SIGN IN"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/auth_title"
                    style="@style/OdText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_1"
                    android:text="Choose how to sign in"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- -- the method list -- -->
            <LinearLayout
                android:id="@+id/card_auth_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_6"
                android:background="@drawable/od_panel"
                android:divider="@drawable/od_divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <!-- == MICROSOFT == the recommended path == -->
                <LinearLayout
                    android:id="@+id/button_microsoft_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/od_row_h_tall"
                    android:background="@drawable/od_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/od_space_3"
                    android:paddingEnd="@dimen/od_space_3">

                    <!-- scope mark: chosen state is a filled ember square.
                         A radio SCOPE rather than a destination glyph, because
                         these three are one exclusive choice. -->
                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/od_bitmap_frame">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_microsoft"
                            app:tint="@color/od_accent_bright" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/OdText.TitleS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="MICROSOFT"
                                tools:ignore="HardcodedText" />

                            <TextView
                                style="@style/OdText.MonoS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/od_space_2"
                                android:background="@drawable/od_keycap"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="RECOMMENDED"
                                android:textColor="@color/od_accent_bright"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <TextView
                            style="@style/OdText.MonoS"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Servers - skins - capes"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/od_text_faint" />
                </LinearLayout>

                <!-- == ELY.BY == -->
                <LinearLayout
                    android:id="@+id/button_elyby_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/od_row_h_tall"
                    android:background="@drawable/od_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/od_space_3"
                    android:paddingEnd="@dimen/od_space_3">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/od_bitmap_frame">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_elyby"
                            app:tint="@color/od_text_muted" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OdText.TitleS"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="ELY.BY"
                            tools:ignore="HardcodedText" />

                        <TextView
                            style="@style/OdText.MonoS"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Free skins - most servers"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/od_text_faint" />
                </LinearLayout>

                <!-- == LOCAL / OFFLINE == -->
                <LinearLayout
                    android:id="@+id/button_local_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/od_row_h_tall"
                    android:background="@drawable/od_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/od_space_3"
                    android:paddingEnd="@dimen/od_space_3">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/od_bitmap_frame">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_offline"
                            app:tint="@color/od_text_muted" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OdText.TitleS"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="LOCAL"
                            tools:ignore="HardcodedText" />

                        <TextView
                            style="@style/OdText.MonoS"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Offline / LAN only"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/od_text_faint" />
                </LinearLayout>
            </LinearLayout>

            <!-- -- footnote, inside the panel where it can actually be read -- -->
            <TextView
                android:id="@+id/auth_footnote"
                style="@style/OdText.MonoS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_4"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="Sign-in credentials are stored only on this device."
                android:textColor="@color/od_text_faint"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
