<!--
  ============================================================================
  LauncherActivity — THE WINDOW
  ============================================================================

  This file used to be a phone shell: content filling the screen with a single
  navigation band along the bottom edge. It is now organised as an application
  WINDOW with three stacked regions, which is the whole point of the redesign:

      +----------------------------------------------------------+
      |  lh_dock            COMMAND BAR   (title + menu strips)  |  top
      +----------------------------------------------------------+
      |                                                          |
      |  container_fragment  WORKSPACE — every page renders here  |  fills
      |                                                          |
      +----------------------------------------------------------+
      |  orbit_status_strip  STATUS STRIP                        |  bottom
      +----------------------------------------------------------+

  The workspace is BOUNDED on both sides now. Before, a page ran edge to edge
  with chrome only at the bottom, so every screen read as a full-bleed mobile
  page. With a bar above and a strip below, the same page reads as a document
  inside a client — which is the entire visual difference between the two
  idioms, and it costs about 68dp of height.

  LAYOUT CONTRACT

    . lh_dock  is pinned to the TOP edge and is wrap_content (two tiers).
    . container_fragment  starts below lh_dock and stops above the status strip.
    . orbit_status_strip  is pinned to the BOTTOM edge.

  LEGACY LOGIC HOSTS

  account_spinner and setting_button are kept as zero-size, permanently-gone
  views so the existing Java (account dialog host, settings icon swap target)
  keeps resolving its R.id.* lookups unchanged.
  ============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgMainDrawable">

    <!-- Legacy logic host: account dialog host. Never renders. -->
    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:dropDownWidth="280dp"
        android:popupBackground="@drawable/bg_account_popup"
        android:popupElevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Legacy logic host: settings icon swap target. Never renders. -->
    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Settings"
        android:src="@drawable/ic_menu_settings"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- -- the command bar: title strip over menu strip, pinned to the top -- -->
    <include
        android:id="@+id/lh_dock"
        layout="@layout/include_lh_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- -- the status strip, pinned to the bottom edge -- -->
    <include
        android:id="@+id/orbit_status_strip"
        layout="@layout/include_orbit_status"
        android:layout_width="0dp"
        android:layout_height="@dimen/od_status_h"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- -- the workspace: bounded above by the bar and below by the strip -- -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/lh_dock"
        app:layout_constraintBottom_toTopOf="@+id/orbit_status_strip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shortcut boot overlay: identical to the shortcut's "Opening Game..."
         screen so the hand-off never flashes the launcher home UI -->
    <include
        android:id="@+id/launch_boot_overlay"
        layout="@layout/screen_opening_game"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Cosmetic cold/warm start greeting. It never blocks initialization or touch. -->
    <LinearLayout
        android:id="@+id/welcome_back_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@drawable/od_panel"
        android:clickable="false"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingVertical="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_2"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="WELCOME BACK"
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_title_m" />

        <TextView
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_1"
            android:text="Your profiles are ready"
            android:textColor="@color/od_text_muted" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
