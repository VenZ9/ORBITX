<!--
  ══════════════════════════════════════════════════════════════════════════════
  LauncherActivity — PORTRAIT shell
  ══════════════════════════════════════════════════════════════════════════════

  ORBIT's chrome is ONE element: the command bar along the bottom edge. There is
  no left navigation rail, no top header band, and no floating settings gear —
  the three things that made the previous shell read as a re-skin of another
  launcher rather than a product of its own.

  LAYOUT CONTRACT

    · container_fragment  owns every pixel ABOVE the bar, edge to edge, and
      starts flush at the top of the display. Each page draws its own heading,
      which is what lets a title run full width instead of being boxed inside a
      header strip.
    · lh_dock             is the bar, pinned to the bottom edge, spanning the
      full width. It is the same include on every page, so navigation can never
      drift between screens.

  LEGACY LOGIC HOSTS

  account_spinner and setting_button are kept as zero-size, permanently-gone
  views. They render nothing and reserve no space; they exist only so the
  existing Java (account dialog host, settings icon swap target) keeps
  resolving its R.id.* lookups unchanged.
  ══════════════════════════════════════════════════════════════════════════════
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgMainDrawable">

    <!-- Legacy logic host: account dialog host. Never renders. -->
    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:dropDownWidth="280dp"
        android:popupBackground="@drawable/bg_account_popup"
        android:popupElevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Legacy logic host: settings icon swap target. Never renders. -->
    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Settings"
        android:src="@drawable/ic_menu_settings"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- The content pane. Full width, and it stops exactly at the bar. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/lh_dock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The command bar: the only chrome in the app. -->
    <include
        android:id="@+id/lh_dock"
        layout="@layout/include_lh_dock"
        android:layout_width="0dp"
        android:layout_height="@dimen/orb_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Old on-screen download progress bar REMOVED (developer req 8). Download
         status is now surfaced only by the notification system. The download
         engine (ProgressKeeper/DownloadControl) is untouched (req 9). -->

    <!-- Shortcut boot overlay: identical to the shortcut's "Opening Game…"
         screen so the hand-off never flashes the launcher home UI -->
    <include
        android:id="@+id/launch_boot_overlay"
        layout="@layout/screen_opening_game"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Cosmetic cold/warm start greeting. It never blocks initialization or touch. -->
    <LinearLayout
        android:id="@+id/welcome_back_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@drawable/bg_skin_library_panel"
        android:clickable="false"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingVertical="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_round" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.16"
            android:text="WELCOME BACK"
            android:textColor="@color/ox_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your profiles are ready"
            android:textColor="@color/ox_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
