<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  LAUNCHER HOME — the two-card composition   (was: list–detail window split)
  ============================================================================

  THE STRUCTURAL CHANGE

  The previous pass turned this screen into a list–detail split: a dense table
  of instances beside an inspector. It was right about needing both questions
  answered at once, and wrong about the SHAPE of the answer — it read as a
  database tool, not as a client.

  This pass keeps the "both at once" idea and re-cuts it as the design does:

      +=====================================+=================+
      |  [@] whoap              ( ONLINE )  |  Instances   n  |
      |  +===============================+  |  =============  |
      |  | PROFILE            Sqqssd   > |  |  [i] Fab Opt    |
      |  +===============================+  |      Fabric  2G |
      |  ( Java 21 ) ( Fabric ) ( 3.5G )    |  =============  |
      |  +===============================+  |  [i] Vanilla    |
      |  |                               |  |      Vanilla 1G |
      |  |        3D SKIN STAGE          |  |  =============  |
      |  |                               |  |  Browse         |
      |  +===============================+  |  Manage         |
      |  +===============================+  |  Backup         |
      |  |          >  PLAY              |  |                 |
      |  +===============================+  |                 |
      +=====================================+=================+

  LEFT — THE HERO CARD (the wider column)

  Everything about the instance you are about to launch, in the order you need
  it: who you are, which profile, what it will run on, the render, the action.
  It is a CARD, not a pane — it has a 20dp radius and a single amber rule along
  its top edge that ties it to the PLAY bar inside it, which is the one warm
  ramp in the app.

  RIGHT — THE LIBRARY CARD (the narrower column)

  Every instance as a scannable list, then the three verbs that act on the
  selected one. Deliberately the quieter of the two cards: a list is read by
  scanning, so it must not compete with the thing you are about to launch.

  WHY TWO CARDS AND NOT TWO PANES

  Panes divide a WINDOW; cards group CONTENT. This screen is content — it is the
  page inside the window, and the window's own chrome (command bar above,
  status strip below) is already doing the dividing. Cutting the page into panes
  as well made the whole app read as a file manager. Two cards on the workspace
  reads as a launcher.

  WHAT IS PRESERVED

  Every id `LauncherHomeFragment` resolves, and every one's TYPE: lh_bg_a/b,
  lh_launch_button, lh_launch_label, lh_launch_specs, lh_spec_java_text,
  lh_spec_ram_text, lh_hero_name, lh_player, lh_account_chip/head/name/type,
  lh_empty, lh_library, lh_dl_pill/icon_wrap/title/percent/detail/bar, lh_edit_btn,
  lh_brand_cluster, lh_brand_mark, lh_brand_sub, lh_content, lh_prod_strip,
  lh_prod_browser/manage/backup, lh_center_guide, plus the legacy brand slots.
  lh_player stays a GLSurfaceView, lh_dl_bar stays a ProgressBar and lh_library
  stays a RecyclerView, because Java casts to those classes.
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_window_bg"
    android:orientation="vertical">

    <!-- == background crossfade pair (driven by the fragment) == -->
    <ImageView
        android:id="@+id/lh_bg_a"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/lh_bg_b"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- legacy brand slots (kept so the fragment's brand binding still resolves) -->
    <TextView
        android:id="@+id/lh_brand_origin"
        style="@style/OdText.MonoS"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lh_brand_flag"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lh_brand_name"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lh_brand_sub_legacy"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- == THE WORKSPACE: two cards side by side == -->
    <LinearLayout
        android:id="@+id/lh_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_space_3"
        android:paddingTop="@dimen/od_space_3"
        android:paddingEnd="@dimen/od_space_3"
        android:paddingBottom="@dimen/od_space_3">

        <!-- ══════════════ LEFT CARD · THE HERO ══════════════ -->
        <LinearLayout
            style="@style/OdCard.Hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.75">

            <!-- identity: avatar, name, auth type, live state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/lh_account_head"
                    style="@style/OdAvatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lh_hero_name"
                        style="@style/OdText.TitleM"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Player" />

                    <TextView
                        android:id="@+id/lh_account_type"
                        style="@style/OdText.MonoS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/od_text_muted"
                        tools:text="OFFLINE" />
                </LinearLayout>

                <TextView
                    style="@style/OdPill.Green"
                    android:layout_marginStart="@dimen/od_space_2"
                    android:text="ONLINE" />
            </LinearLayout>

            <!-- the profile selector: a discrete target nested in the card -->
            <LinearLayout
                android:id="@+id/lh_account_chip"
                style="@style/OdInnerRow"
                android:layout_marginTop="@dimen/od_space_3">

                <TextView
                    style="@style/OdText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/lh_account_name"
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/od_text"
                    tools:text="Player" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="@dimen/od_space_2"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/od_text_muted" />
            </LinearLayout>

            <!-- the runtime facts, each a coloured capsule. Blue is the loader,
                 gold is Java, neutral is memory — one hue, one meaning. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_3"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lh_spec_java_text"
                    style="@style/OdPill.Gold"
                    tools:text="JAVA 21+" />

                <TextView
                    android:id="@+id/lh_spec_loader_text"
                    style="@style/OdPill.Blue"
                    android:layout_marginStart="@dimen/od_pill_gap"
                    tools:text="FABRIC" />

                <TextView
                    android:id="@+id/lh_spec_ram_text"
                    style="@style/OdPill"
                    android:layout_marginStart="@dimen/od_pill_gap"
                    tools:text="3.5 GB" />
            </LinearLayout>

            <!-- the stage: a recessed viewport the skin render stands in -->
            <FrameLayout
                style="@style/OdHeroStage"
                android:layout_marginTop="@dimen/od_space_3"
                android:layout_weight="1">

                <android.opengl.GLSurfaceView
                    android:id="@+id/lh_player"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- extra runtime rows the fragment assembles at runtime -->
            <LinearLayout
                android:id="@+id/lh_launch_specs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                android:orientation="vertical" />

            <!-- the primary action: the one warm ramp in the app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_3"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lh_launch_label"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <net.kdt.pojavlaunch.ui.PremiumPlayButtonView
                    android:id="@+id/lh_launch_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/od_play_h" />
            </LinearLayout>
        </LinearLayout>

        <!-- the gutter between the two cards -->
        <Space
            android:layout_width="@dimen/od_space_3"
            android:layout_height="1dp" />

        <!-- ══════════════ RIGHT CARD · THE LIBRARY ══════════════ -->
        <LinearLayout
            style="@style/OdCard.Flush"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- card header: what this list is, how many, and the one action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_pad_card"
                android:paddingTop="@dimen/od_pad_card"
                android:paddingEnd="@dimen/od_pad_card_tight"
                android:paddingBottom="@dimen/od_space_3">

                <View
                    android:id="@+id/lh_brand_cluster"
                    android:layout_width="3dp"
                    android:layout_height="@dimen/od_thumb"
                    android:layout_marginEnd="@dimen/od_space_2"
                    android:background="@color/od_accent" />

                <TextView
                    android:id="@+id/lh_brand_mark"
                    style="@style/OdCard.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Instances" />

                <TextView
                    android:id="@+id/lh_brand_sub"
                    style="@style/OdText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/od_space_1"
                    android:text="LIBRARY" />

                <!-- contextual edit — wired to the existing handler -->
                <ImageView
                    android:id="@+id/lh_edit_btn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/od_icon_button"
                    android:clickable="true"
                    android:contentDescription="@string/edit_profile"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_edit_profile"
                    app:tint="@color/od_text_dim" />
            </LinearLayout>

            <View style="@style/OdCard.Rule" />

            <!-- the instance list itself (InstanceLibraryAdapter) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/lh_center_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lh_library"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingTop="@dimen/od_space_2"
                    android:paddingBottom="@dimen/od_space_2"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/lh_empty"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/od_space_4"
                    android:background="@color/od_rule"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View style="@style/OdCard.Rule" />

            <!-- the command stack: three verbs that act on the selected instance -->
            <LinearLayout
                android:id="@+id/lh_prod_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/od_space_2"
                android:paddingTop="@dimen/od_space_2"
                android:paddingEnd="@dimen/od_space_2"
                android:paddingBottom="@dimen/od_space_2">

                <LinearLayout
                    android:id="@+id/lh_prod_browser"
                    style="@style/OdInnerRow"
                    android:layout_height="@dimen/od_row_h_toolbar">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_browser_resources"
                        app:tint="@color/od_text_dim" />

                    <TextView
                        style="@style/OdText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:text="Browse"
                        android:textColor="@color/od_text_dim" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/od_text_faint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lh_prod_manage"
                    style="@style/OdInnerRow"
                    android:layout_height="@dimen/od_row_h_toolbar"
                    android:layout_marginTop="@dimen/od_pill_gap">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/od_text_dim" />

                    <TextView
                        style="@style/OdText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:text="Manage"
                        android:textColor="@color/od_text_dim" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/od_text_faint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lh_prod_backup"
                    style="@style/OdInnerRow"
                    android:layout_height="@dimen/od_row_h_toolbar"
                    android:layout_marginTop="@dimen/od_pill_gap">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder_managed"
                        app:tint="@color/od_text_dim" />

                    <TextView
                        style="@style/OdText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:text="Backup"
                        android:textColor="@color/od_text_dim" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/od_text_faint" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- == COMPACT DOWNLOAD STRIP — the same information the old floating pill
         carried, but as a status row docked above the window's status strip. -->
    <LinearLayout
        android:id="@+id/lh_dl_pill"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/od_statusstrip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_space_3"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/lh_dl_icon_wrap"
            android:layout_width="22dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/lh_dl_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@color/od_accent_bright" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lh_dl_title"
                    style="@style/OdText.MonoS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/od_text_dim" />

                <TextView
                    android:id="@+id/lh_dl_percent"
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/od_accent_bright" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/lh_dl_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="3dp"
                android:progressDrawable="@drawable/od_progress" />
        </LinearLayout>

        <TextView
            android:id="@+id/lh_dl_detail"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/od_text_faint" />
    </LinearLayout>
</LinearLayout>
