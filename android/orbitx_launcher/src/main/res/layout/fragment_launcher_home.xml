<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  LAUNCHER HOME — the list–detail workspace   (was: full-bleed hero stage)
  ============================================================================

  THE STRUCTURAL CHANGE

  The screen this replaces was a STAGE: one instance's artwork filled the whole
  display under a scrim, a 3D skin model bobbed in the middle, a big capsule
  launched it, and every other instance was demoted to a horizontal carousel of
  artwork tiles along the bottom.

  That is a home screen: it shows you ONE thing beautifully and hides the rest.
  But this is a client for managing MANY instances, so the carousel was the only
  place you could see your other profiles — the one place with the least room.

  It is now a WINDOW WORKSPACE, split by a hairline into two panes:

      +---------------------------+------------------------------+
      | INSTANCES             n   |  [icon] Fabulously Optimized |  inspector
      | ------------------------- |  [3D skin]  JAVA 17          |
      | [i] Fabulously Optimized  |             RAM 2048         |
      |     Fabric  1.21   2 GB   |  ---------------------------- |
      | ------------------------- |  BROWSE | MANAGE | BACKUP    |  command row
      | [i] Vanilla               |  ---------------------------- |
      |     Vanilla 1.21   1 GB   |  [        LAUNCH         ]   |  primary
      | ------------------------- |                              |
      +---------------------------+------------------------------+

  The list pane is the primary surface — every instance, all at once, as a
  scannable table. The inspector pane carries the one instance you selected:
  its identity, its skin, its runtime figures, its command row, and the launch
  control. Nothing is hidden behind a carousel any more.

  WHY THE SPLIT AND NOT A FULL-WIDTH LIST

  A launcher's two questions are "which instance?" and "what is it?" — a list
  answers the first and destroys the second. Keeping both on screen at once is
  what lets you compare two profiles by eye without navigating anywhere.

  WHAT IS PRESERVED

  Every id `LauncherHomeFragment` resolves: lh_bg_a/b, lh_launch_button,
  lh_launch_label, lh_launch_specs, lh_spec_java_text, lh_spec_ram_text,
  lh_hero_name, lh_player, lh_account_chip/head/name/type, lh_empty, lh_library,
  lh_dl_pill/icon_wrap/title/percent/detail/bar, lh_edit_btn, lh_brand_cluster,
  lh_content, lh_prod_browser/manage/backup, lh_center_guide, plus every brand
  and home_* id. Types are unchanged (lh_player stays a GLSurfaceView, lh_dl_bar
  stays a ProgressBar, lh_library stays a RecyclerView).
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_window_bg"
    android:orientation="vertical">

    <!-- -- background crossfade pair (driven by the fragment) -- -->
    <ImageView
        android:id="@+id/lh_bg_a"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/lh_bg_b"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- == WORKSPACE HEADER STRIP == a desktop document header: what this pane
         holds, how many, and the one action that refreshes it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_pane_header_h"
        android:background="@drawable/od_pane_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter">

        <View
            android:id="@+id/lh_brand_cluster"
            android:layout_width="10dp"
            android:layout_height="@dimen/od_thumb"
            android:layout_marginEnd="@dimen/od_space_2"
            android:background="@drawable/od_live_dot" />

        <TextView
            android:id="@+id/lh_brand_mark"
            style="@style/OdText.TitleM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="ORBITX" />

        <TextView
            android:id="@+id/lh_brand_origin"
            style="@style/OdText.MonoS"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lh_brand_flag"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lh_brand_sub"
            style="@style/OdText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_3"
            android:text="INSTANCE LIBRARY" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- live count, mono, right-aligned beside the account chip -->
        <TextView
            android:id="@+id/lh_spec_java_text"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/od_space_3"
            tools:text="JAVA 17" />

        <!-- the account chip: avatar, name, auth type — one field of the header -->
        <LinearLayout
            android:id="@+id/lh_account_chip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/od_thumb"
            android:layout_marginEnd="@dimen/od_space_2"
            android:background="@drawable/od_well"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/od_space_1"
            android:paddingEnd="@dimen/od_space_3">

            <ImageView
                android:id="@+id/lh_account_head"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lh_account_name"
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/od_text"
                    tools:text="Player" />

                <TextView
                    android:id="@+id/lh_account_type"
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/od_text_faint"
                    tools:text="OFFLINE" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- == THE WORKSPACE: two panes and the splitter between them == -->
    <LinearLayout
        android:id="@+id/lh_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- --------------- LEFT PANE . INSTANCE TABLE --------------- -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:background="@drawable/od_pane"
            android:orientation="vertical">

            <!-- column header: this is a TABLE, so it names its columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_gutter">

                <TextView
                    style="@style/OdText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Instance" />

                <TextView
                    style="@style/OdText.Label"
                    android:layout_width="@dimen/od_col_meta"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Loader" />

                <TextView
                    style="@style/OdText.Label"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/od_space_2"
                    android:gravity="end"
                    android:text="RAM" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/od_rule_strong" />

            <!-- the instance table itself (InstanceLibraryAdapter) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/lh_center_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lh_library"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/od_space_3"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/lh_empty"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/od_space_4"
                android:background="@color/od_rule"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ------------------- THE SPLITTER ------------------- -->
        <View
            android:layout_width="@dimen/od_splitter_w"
            android:layout_height="match_parent"
            android:background="@drawable/od_splitter" />

        <!-- ------------------- RIGHT PANE . INSPECTOR ------------------- -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/od_pane_raised"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_space_3"
                android:paddingEnd="@dimen/od_space_3">

                <TextView
                    style="@style/OdText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Selected instance" />

                <!-- contextual edit — wired to the existing handler -->
                <ImageView
                    android:id="@+id/lh_edit_btn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/od_icon_button"
                    android:clickable="true"
                    android:contentDescription="@string/edit_profile"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_edit_profile"
                    app:tint="@color/od_text_dim" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/od_rule_strong" />

            <!-- identity: the instance name, then its skin render -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_space_3"
                android:paddingTop="@dimen/od_space_3"
                android:paddingEnd="@dimen/od_space_3"
                android:paddingBottom="@dimen/od_space_2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lh_hero_name"
                        style="@style/OdText.TitleM"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="Fabulously Optimized" />

                    <TextView
                        android:id="@+id/lh_spec_ram_text"
                        style="@style/OdText.MonoS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_1"
                        tools:text="RAM 2048 MB" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- runtime figures as a tight two-row readout table -->
                    <LinearLayout
                        android:id="@+id/lh_launch_specs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/od_space_3"
                    android:layout_marginEnd="@dimen/od_space_3"
                    android:background="@color/od_rule" />

                <!-- the live skin render sits in a framed well, like a viewport -->
                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/od_well">

                    <android.opengl.GLSurfaceView
                        android:id="@+id/lh_player"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>

            <!-- -- command row: browse . manage . backup, three equal verbs -- -->
            <LinearLayout
                android:id="@+id/lh_prod_strip"
                android:layout_width="match_parent"
                android:layout_height="@dimen/od_row_h"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lh_prod_browser"
                    style="@style/OdRow"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_browser_resources"
                        app:tint="@color/od_text_dim" />

                    <TextView
                        style="@style/OdText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:text="Browse"
                        android:textColor="@color/od_text_dim" />
                </LinearLayout>

                <View style="@style/OdSplitter" />

                <LinearLayout
                    android:id="@+id/lh_prod_manage"
                    style="@style/OdRow"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/od_text_dim" />

                    <TextView
                        style="@style/OdText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:text="Manage"
                        android:textColor="@color/od_text_dim" />
                </LinearLayout>

                <View style="@style/OdSplitter" />

                <LinearLayout
                    android:id="@+id/lh_prod_backup"
                    style="@style/OdRow"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder_managed"
                        app:tint="@color/od_text_dim" />

                    <TextView
                        style="@style/OdText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:text="Backup"
                        android:textColor="@color/od_text_dim" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/od_rule" />

            <!-- -- the primary action: launch. The only filled object in the pane. -- -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/od_row_h_tall"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_space_3"
                android:paddingEnd="@dimen/od_space_3">

                <net.kdt.pojavlaunch.ui.PremiumPlayButtonView
                    android:id="@+id/lh_launch_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/od_row_h"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/lh_launch_label"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- legacy brand slot (kept so the fragment's brand binding still resolves) -->
    <TextView
        android:id="@+id/lh_brand_name"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lh_brand_sub_legacy"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- == COMPACT DOWNLOAD STRIP — the same information the old floating pill
         carried, but as a status row docked above the window's status strip. -->
    <LinearLayout
        android:id="@+id/lh_dl_pill"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/od_statusstrip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_space_3"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/lh_dl_icon_wrap"
            android:layout_width="22dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/lh_dl_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@color/od_accent_bright" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lh_dl_title"
                    style="@style/OdText.MonoS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/od_text_dim" />

                <TextView
                    android:id="@+id/lh_dl_percent"
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/od_accent_bright" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/lh_dl_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="3dp"
                android:progressDrawable="@drawable/od_progress" />
        </LinearLayout>

        <TextView
            android:id="@+id/lh_dl_detail"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/od_text_faint" />
    </LinearLayout>
</LinearLayout>
