<?xml version="1.0" encoding="utf-8"?>
<!--
  "Save or play?" popup shown when a server card's PLAY button is tapped.
  Deliberately short: one line of text and two obvious buttons.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/spd_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/od_panel"
        android:orientation="vertical">

        <!-- Artwork head (built-in server only) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/spd_banner_card"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/spd_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_plantmc_banner" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_featured_scrim" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/spd_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="PlantMC"
            android:textColor="@color/od_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spd_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="play.plantmc.fun:25627"
            android:textColor="@color/od_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/spd_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="Play now, or just save it to your list?"
            android:textColor="@color/od_text"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spd_btn_save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_ghost_btn"
                android:gravity="center"
                android:text="SAVE"
                android:textColor="@color/od_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/spd_btn_play"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_featured_play"
                android:elevation="2dp"
                android:gravity="center"
                android:text="PLAY"
                android:textColor="@color/od_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Community link removed app-wide: the id is kept so the dialog code
             still resolves it, but it is never shown. -->
        <TextView
            android:id="@+id/spd_btn_discord"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
