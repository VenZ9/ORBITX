<?xml version="1.0" encoding="utf-8"?>
<!-- COPY MOD TO PROFILE — pick a target profile; the .jar is copied on disk
     so nothing is downloaded again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/od_on_accent"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/copy_target_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/copy_target_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="#EEE8E8"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/copy_target_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mod_copy_title"
                android:textColor="@color/od_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/copy_target_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/od_text_muted"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="middle"
                tools:text="sodium-fabric-1.20.1.jar" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#241E1E" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/copy_target_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        android:overScrollMode="never"
        tools:listitem="@layout/item_copy_target_profile" />

    <TextView
        android:id="@+id/copy_target_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/mod_copy_no_targets"
        android:textColor="@color/od_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
