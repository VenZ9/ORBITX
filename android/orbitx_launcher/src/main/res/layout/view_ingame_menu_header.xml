<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — in-game command panel TITLE STRIP  (view_ingame_menu_header)

  The header of the panel that opens over the running game. It is modelled on a
  window's title bar: a live indicator and the scope on the leading edge, a
  dismiss affordance on the trailing edge, then the two facts the user needs
  while playing — which instance is running and which version.

  It is a STATUS BLOCK, not a card: no rounded background, no elevation. The
  hairline underneath is the table header for the numbered command rows below
  it.

  Ids preserved for MainActivity: igm_hdr_dot, igm_hdr_kicker, igm_hdr_esc,
  igm_hdr_title, igm_hdr_sub.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/od_panel_titlebar"
    android:orientation="vertical"
    android:paddingStart="@dimen/od_space_3"
    android:paddingEnd="@dimen/od_space_2"
    android:paddingTop="@dimen/od_space_3"
    android:paddingBottom="@dimen/od_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/igm_hdr_dot"
            android:layout_width="@dimen/od_status_dot"
            android:layout_height="@dimen/od_status_dot"
            android:background="@drawable/od_live_dot" />

        <TextView
            android:id="@+id/igm_hdr_kicker"
            style="@style/OdText.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ORBITX - IN-GAME"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/igm_hdr_esc"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/od_keycap"
            android:gravity="center"
            android:paddingStart="@dimen/od_space_2"
            android:paddingEnd="@dimen/od_space_2"
            android:text="SWIPE >"
            android:textColor="@color/od_text_dim"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <TextView
        android:id="@+id/igm_hdr_title"
        style="@style/OdText.TitleM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/od_space_3"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Profile"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/igm_hdr_sub"
        style="@style/OdText.Ember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="1.21"
        tools:ignore="HardcodedText" />
</LinearLayout>
