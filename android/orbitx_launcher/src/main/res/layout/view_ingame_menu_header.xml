<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT — in-game drawer header.

  A status block, not a card: a live orbit ring, the ORBITX kicker, the
  profile being played, and its version in mono. The rule underneath is the
  table header for the action rows below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/igm_hdr_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/orb_ring_live" />

        <TextView
            android:id="@+id/igm_hdr_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="@dimen/orb_text_label_xs_tracking"
            android:text="ORBITX \u00b7 IN-GAME"
            android:textColor="@color/ox_text_tertiary"
            android:textSize="@dimen/orb_text_label_xs" />

        <TextView
            android:id="@+id/igm_hdr_esc"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/orb_index_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="SWIPE \u203a"
            android:textColor="@color/ox_text_muted"
            android:textSize="@dimen/orb_text_label_xs" />
    </LinearLayout>

    <TextView
        android:id="@+id/igm_hdr_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"
        android:maxLines="1"
        android:text="Profile"
        android:textColor="@color/ox_text_primary"
        android:textSize="@dimen/orb_text_title_m" />

    <TextView
        android:id="@+id/igm_hdr_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="1.21"
        android:textColor="@color/ox_ember_bright"
        android:textSize="@dimen/orb_text_mono_s" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/ox_hairline_strong" />
</LinearLayout>
