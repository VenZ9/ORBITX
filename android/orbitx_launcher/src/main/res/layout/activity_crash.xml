<?xml version="1.0" encoding="utf-8"?>
<!-- Crash Mission Control — diagnosis left, technical log right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_window_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">
        <FrameLayout
            android:id="@+id/crash_back_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/od_pane_raised"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/ic_arrow_back" app:tint="#E9E5E5" android:contentDescription="Back" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRASH MISSION CONTROL" android:textColor="@color/od_text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="ORBITX analysed why Minecraft stopped" android:textColor="@color/od_text_muted" android:textSize="9sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="25dp" android:background="@drawable/bg_crash_status" android:gravity="center" android:letterSpacing="0.08" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="GAME STOPPED" android:textColor="@color/od_accent_bright" android:textSize="8sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#322A2A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/crash_analysis_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="0.42"
            android:background="@drawable/bg_crash_panel"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:padding="15dp"
            android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/crash_category" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.09" android:text="UNKNOWN CRASH" android:textColor="@color/od_text_muted" android:textSize="8.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/crash_confidence" android:layout_width="wrap_content" android:layout_height="22dp" android:background="@drawable/od_well" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="35% MATCH" android:textColor="@color/od_text" android:textSize="7.5sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/crash_reason_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Minecraft closed unexpectedly" android:textColor="@color/od_text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/crash_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="2dp" android:textColor="@color/od_text" android:textSize="11sp" />

                <LinearLayout android:id="@+id/crash_culprit_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_crash_culprit" android:orientation="vertical" android:padding="11dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POSSIBLE CULPRIT" android:textColor="@color/od_warn" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:id="@+id/crash_culprit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:fontFamily="monospace" android:textColor="@color/od_warn" android:textSize="10sp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:letterSpacing="0.09" android:text="RECOMMENDED FIXES" android:textColor="@color/od_text_dim" android:textSize="8.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/crash_solutions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp" android:textColor="@color/od_text" android:textSize="10sp" />

                <LinearLayout android:id="@+id/upload_result_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_crash_success" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp" android:visibility="gone">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_check_circle" app:tint="#8FD3A5" android:contentDescription="Uploaded" />
                    <TextView android:id="@+id/upload_result_url" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:autoLink="web" android:ellipsize="end" android:maxLines="1" android:textColor="@color/od_live" android:textSize="9sp" />
                    <ImageButton android:id="@+id/btn_copy_url" android:layout_width="30dp" android:layout_height="30dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp" android:src="@drawable/ic_copy" app:tint="@color/od_live" android:contentDescription="Copy link" />
                    <ImageButton android:id="@+id/btn_share_url" android:layout_width="30dp" android:layout_height="30dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp" android:src="@drawable/ic_menu_share" app:tint="@color/od_live" android:contentDescription="Share link" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/crash_log_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="0.58"
            android:background="@drawable/bg_crash_panel"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="7dp" android:layout_height="7dp" android:background="@drawable/bg_log_dot" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="FULL TECHNICAL LOG" android:textColor="@color/od_text_dim" android:textSize="8.5sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/crash_loading" style="?android:attr/progressBarStyleSmall" android:layout_width="18dp" android:layout_height="18dp" android:indeterminateTint="@color/od_text_dim" android:visibility="gone" />
            </LinearLayout>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:background="#A60C0808" android:overScrollMode="ifContentScrolls" android:padding="10dp">
                <TextView android:id="@+id/crash_log_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:lineSpacingExtra="2dp" android:textColor="@color/od_text_dim" android:textIsSelectable="true" android:textSize="9sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="#171111" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
        <Button android:id="@+id/btn_upload_log" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:layout_weight="1.5" android:background="@drawable/bg_crash_primary" android:stateListAnimator="@null" android:text="ANALYSE &amp; SHARE" android:textColor="@color/od_text" android:textSize="10sp" android:textStyle="bold" />
        <Button android:id="@+id/btn_copy_log" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@drawable/od_pane_raised" android:stateListAnimator="@null" android:text="COPY RAW LOG" android:textColor="@color/od_text" android:textSize="9.5sp" android:textStyle="bold" />
        <Button android:id="@+id/btn_home" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/od_pane_raised" android:stateListAnimator="@null" android:text="RETURN HOME" android:textColor="@color/od_text" android:textSize="9.5sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
