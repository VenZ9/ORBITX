<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — instance TABLE ROW, full-width variant
  (item_home_profile_card)

  THE STRUCTURAL CHANGE

  This was a poster card: a full-bleed artwork background with a legibility
  scrim, a floating version badge, a favourite star, an icon, then a name, a
  version line, a mod count and a RAM figure stacked in prose — and four
  separate circular action buttons below. It is now one dense 56dp TABLE ROW
  with aligned columns:

      [icon]  Fabulously Optimized     Fabric 1.21    128    2 GB   > : :

  - the artwork becomes a 36dp framed icon; the scrim and the badge are retired
    (kept as ids, zero size) because a row does not need legibility insurance
  - name / version / mods / RAM become four aligned fields, the last three in
    monospace so the columns line up down the table
  - the four circular buttons become a single trailing action group

  Ids preserved: card_profile_root, img_profile_background,
  img_profile_background_scrim, tv_version_badge, btn_profile_favorite,
  img_profile_icon, tv_profile_name, tv_profile_version, tv_profile_mod_count,
  tv_profile_ram, btn_profile_shortcut, btn_profile_drag, btn_profile_browse,
  btn_profile_play.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_profile_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/od_row_h_tall"
    android:background="@drawable/od_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/od_space_3"
    android:paddingEnd="@dimen/od_space_1">

    <!-- retired layers: the artwork and its scrim. Kept so the adapter's
         crossfade and scrim lookups still resolve; never drawn. -->
    <ImageView
        android:id="@+id/img_profile_background"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/img_profile_background_scrim"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- == INSTANCE field == icon + name -->
    <ImageView
        android:id="@+id/img_profile_icon"
        android:layout_width="@dimen/od_thumb_lg"
        android:layout_height="@dimen/od_thumb_lg"
        android:background="@drawable/od_bitmap_frame"
        android:contentDescription="@null"
        android:padding="1dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/od_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_profile_name"
            style="@style/OdText.TitleS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/od_text_body"
            tools:text="Fabulously Optimized" />

        <TextView
            android:id="@+id/tv_version_badge"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/od_keycap"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/od_text_muted"
            tools:text="FABRIC" />
    </LinearLayout>

    <!-- == VERSION field — right-aligned mono column == -->
    <TextView
        android:id="@+id/tv_profile_version"
        style="@style/OdText.MonoS"
        android:layout_width="@dimen/od_col_meta"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        tools:text="1.21.4" />

    <!-- == MODS field == -->
    <TextView
        android:id="@+id/tv_profile_mod_count"
        style="@style/OdText.MonoS"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        tools:text="128" />

    <!-- == RAM field — the one figure that matters most, so it is ember == -->
    <TextView
        android:id="@+id/tv_profile_ram"
        style="@style/OdText.Ember"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        tools:text="2048" />

    <!-- == ACTION GROUP == -->
    <ImageButton
        android:id="@+id/btn_profile_favorite"
        style="@style/OdButton.Icon"
        android:contentDescription="@string/orbitx_cd_favourite"
        android:src="@drawable/ic_csp_star_outline"
        app:tint="@color/od_text_muted" />

    <ImageButton
        android:id="@+id/btn_profile_browse"
        style="@style/OdButton.Icon"
        android:contentDescription="@string/orbitx_cd_browse"
        android:src="@drawable/ic_folder_managed"
        app:tint="@color/od_text_muted" />

    <ImageButton
        android:id="@+id/btn_profile_shortcut"
        style="@style/OdButton.Icon"
        android:contentDescription="@string/orbitx_cd_shortcut"
        android:src="@drawable/ic_add"
        app:tint="@color/od_text_muted" />

    <ImageButton
        android:id="@+id/btn_profile_drag"
        style="@style/OdButton.Icon"
        android:contentDescription="@string/orbitx_cd_reorder"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/od_text_muted" />

    <!-- the primary action of the row, and the only filled object in it -->
    <FrameLayout
        android:id="@+id/btn_profile_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/od_space_1"
        android:background="@drawable/od_btn_primary"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@string/orbitx_cd_launch"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/od_on_accent" />
    </FrameLayout>
</LinearLayout>
