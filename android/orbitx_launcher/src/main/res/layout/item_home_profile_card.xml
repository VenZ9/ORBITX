<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT — one instance in the library.

  Read top-left to bottom-right as a data row, not a poster:

    ▌│[icon]  NAME                      (identity, largest type on the card)
    ▌│        VERSION · MODS · RAM       (mono, the figures you compare)
    ▌│        ─────────────────────────
    ▌│        SHORTCUT  REORDER  BROWSE  ▶ LAUNCH

  The ember spine down the left edge is the ORBIT signature: a card you have
  selected carries a lit edge, an unselected one carries a dark edge. It is a
  single View with no logic, so selection state stays owned by the fragment.

  Every id the adapter binds is preserved; the GIF banner, scrim and version
  badge layers stay in place above the content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/orb_space_1"
    android:layout_marginVertical="@dimen/orb_space_1"
    android:background="@drawable/bg_profile_card"
    android:stateListAnimator="@animator/card_press_anim"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <!-- Custom banner / animated GIF, drawn under the content. -->
    <ImageView
        android:id="@+id/img_profile_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/img_profile_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_profile_card_scrim"
        android:visibility="gone" />

    <!-- Signature ember spine. Static: selection is a fragment concern. -->
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/ox_ember" />

    <!-- Version badge, pinned top-right. -->
    <TextView
        android:id="@+id/tv_version_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/orb_space_3"
        android:layout_marginEnd="@dimen/orb_space_4"
        android:background="@drawable/bg_cs_version_badge"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:maxWidth="82dp"
        android:minWidth="54dp"
        android:paddingHorizontal="@dimen/orb_space_2"
        android:paddingVertical="3dp"
        android:textColor="@color/ox_ember_bright"
        android:textSize="@dimen/orb_text_label_xs"
        android:visibility="gone" />

    <!-- Favourite toggle — independent of launch selection. -->
    <ImageButton
        android:id="@+id/btn_profile_favorite"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="92dp"
        android:background="@drawable/bg_browse_button"
        android:contentDescription="Favorite instance"
        android:padding="7dp"
        android:src="@drawable/ic_csp_star_outline"
        android:tint="@color/ox_text_tertiary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/orb_space_3"
        android:paddingEnd="@dimen/orb_space_3">

        <!-- Identity: icon, name, figures. End padding reserves the corner
             where the version badge and favourite float. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/orb_space_4"
            android:paddingBottom="@dimen/orb_space_3">

            <ImageView
                android:id="@+id/img_profile_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="@dimen/orb_space_3"
                android:background="@drawable/bg_profile_icon_rounded"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_profile_name"
                    style="@style/OrbitText.TitleS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingEnd="124dp" />

                <!-- The figures row: quiet mono, one ember value for mods. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_profile_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:textColor="@color/ox_text_secondary"
                        android:textSize="@dimen/orb_text_mono_s" />

                    <TextView
                        android:id="@+id/tv_profile_mod_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/orb_space_2"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:textColor="@color/ox_ember_bright"
                        android:textSize="@dimen/orb_text_mono_s" />

                    <TextView
                        android:id="@+id/tv_profile_ram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/orb_space_2"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:textColor="@color/ox_text_tertiary"
                        android:textSize="@dimen/orb_text_mono_s" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Hairline IS the separator between the data block and the actions. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ox_hairline" />

        <!-- Action row: three quiet icon targets, then the one filled launch. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/orb_space_2"
            android:paddingBottom="@dimen/orb_space_3">

            <FrameLayout
                android:id="@+id/btn_profile_shortcut"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="@dimen/orb_space_1"
                android:background="@drawable/bg_browse_button"
                android:clickable="true"
                android:contentDescription="@string/shortcut_add_title"
                android:focusable="true"
                android:stateListAnimator="@animator/card_press_anim">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shortcut_add"
                    android:tint="@color/ox_text_tertiary" />
            </FrameLayout>

            <!-- Only this view can start a reorder drag. -->
            <FrameLayout
                android:id="@+id/btn_profile_drag"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="@dimen/orb_space_1"
                android:background="@drawable/bg_browse_button"
                android:clickable="true"
                android:contentDescription="Hold and drag to reorder instance"
                android:focusable="true"
                android:stateListAnimator="@animator/card_press_anim">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_drag_handle"
                    android:tint="@color/ox_text_tertiary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_profile_browse"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_browse_button"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/card_press_anim">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="Browse content"
                    android:src="@drawable/ic_profile_download"
                    android:tint="@color/ox_text_tertiary" />
            </FrameLayout>

            <!-- Launch — the only filled control on the card. -->
            <net.kdt.pojavlaunch.ui.PremiumPlayButtonView
                android:id="@+id/btn_profile_play"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="@dimen/orb_space_2"
                android:layout_weight="1"
                android:contentDescription="@string/cs_world_play">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/ox_on_ember" />
            </net.kdt.pojavlaunch.ui.PremiumPlayButtonView>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
