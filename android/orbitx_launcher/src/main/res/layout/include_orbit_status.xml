<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  ORBIT DESKTOP — the status strip
  ============================================================================

  The third and last piece of the window frame, and the piece the previous shell
  was missing entirely. A desktop application always keeps a thin strip along
  the bottom edge that answers "what is the application doing right now".

  Three zones, left to right — the footer of the design this pass is built to:

     [.] All systems operational        ORBITX — ANDROID      v3.2.0
      ^  state, in mono              centred build id      version, faint

  The strip is closed by a 1dp rule along its TOP edge, mirroring the command
  bar's rule along its bottom edge. Together those two rules are what make the
  content region read as a bounded workspace rather than as the whole screen.

  It sits BELOW the content pane and never scrolls, never collapses, and is
  never covered by a page. The three cells are weighted EQUALLY rather than
  sized to their content, so the middle cell is centred on the WINDOW and does
  not drift when the state string on the left changes length.
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orbit_status_strip"
    android:layout_width="match_parent"
    android:layout_height="@dimen/od_status_h"
    android:background="@drawable/od_statusstrip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/od_space_3"
    android:paddingEnd="@dimen/od_space_3">

    <!-- ZONE 1 · state -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/orbit_status_dot"
            android:layout_width="@dimen/od_status_dot"
            android:layout_height="@dimen/od_status_dot"
            android:background="@drawable/od_live_dot" />

        <TextView
            android:id="@+id/orbit_status_text"
            style="@style/OdChrome.StatusCell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:text="READY"
            android:textColor="@color/od_text_dim" />
    </LinearLayout>

    <!-- ZONE 2 · build identity, centred on the window -->
    <TextView
        android:id="@+id/orbit_status_build"
        style="@style/OdChrome.StatusCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="ORBITX - ANDROID"
        android:textColor="@color/od_text_faint" />

    <!-- ZONE 3 · version, trailing -->
    <TextView
        android:id="@+id/orbit_status_version"
        style="@style/OdChrome.StatusCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:letterSpacing="0.08"
        android:text="v3.2.0"
        android:textColor="@color/od_text_muted" />
</LinearLayout>
