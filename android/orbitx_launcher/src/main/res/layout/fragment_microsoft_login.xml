<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — MICROSOFT SIGN-IN  (was: a brand column beside a step rail)

  Retuned onto the window language. The handshake is now presented as a HEALTH
  READOUT — the same three-step tracker, but drawn as a status column with
  square state dots and mono labels, which is how a desktop client reports an
  in-progress connection. The embedded browser sits in an inset WELL so the
  web content reads as a viewport inside the window, not as a floating card.

  Ids preserved: ms_brand_column, ms_step_1_dot, ms_step_1, ms_step_2_dot,
  ms_step_2, ms_step_3_dot, ms_step_3, ms_status, ms_web_frame,
  microsoft_login_webview (WebView), ms_progress (ProgressBar).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_pane"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- == LEADING PANE - the handshake readout == -->
    <LinearLayout
        android:id="@+id/ms_brand_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:background="@drawable/od_pane_raised"
        android:orientation="vertical"
        android:paddingStart="@dimen/od_gutter"
        android:paddingTop="@dimen/od_space_5"
        android:paddingEnd="@dimen/od_gutter"
        android:paddingBottom="@dimen/od_space_5">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/od_bitmap_frame">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_auth_microsoft"
                app:tint="@color/od_accent_bright" />
        </FrameLayout>

        <TextView
            style="@style/OdText.TitleM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_3"
            android:text="Microsoft"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/OdText.MonoS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Xbox Live authentication"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/od_space_4"
            android:layout_marginBottom="@dimen/od_space_4"
            android:background="@color/od_rule_strong" />

        <TextView
            style="@style/OdText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Handshake"
            tools:ignore="HardcodedText" />

        <!-- step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/ms_step_1_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/od_live_dot" />

            <TextView
                android:id="@+id/ms_step_1"
                style="@style/OdText.MonoS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Microsoft login"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/ms_step_2_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/od_live_dot_idle" />

            <TextView
                android:id="@+id/ms_step_2"
                style="@style/OdText.MonoS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Xbox Live handshake"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/ms_step_3_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/od_live_dot_idle" />

            <TextView
                android:id="@+id/ms_step_3"
                style="@style/OdText.MonoS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Minecraft profile + skin"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ms_status"
            style="@style/OdText.MonoS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/od_text_muted"
            tools:text="Waiting..." />
    </LinearLayout>

    <View
        android:layout_width="@dimen/od_splitter_w"
        android:layout_height="match_parent"
        android:background="@drawable/od_splitter" />

    <!-- == TRAILING PANE - the embedded browser, in a well == -->
    <FrameLayout
        android:id="@+id/ms_web_frame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/od_well"
        android:padding="@dimen/od_space_2">

        <WebView
            android:id="@+id/microsoft_login_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/ms_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:progressDrawable="@drawable/od_progress" />
    </FrameLayout>
</LinearLayout>
