<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/igm_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/orb_row_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Index numeral: keys the row without a decorative icon chip. -->
        <TextView
            android:id="@+id/igm_key"
            android:layout_width="26dp"
            android:layout_height="22dp"
            android:background="@drawable/orb_index_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/ox_text_tertiary"
            android:textSize="@dimen/orb_text_label_xs" />

        <!-- Vertical rule: the index column and the content column are
             separate fields of one table. -->
        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="12dp"
            android:background="@color/ox_hairline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/igm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/ox_text_primary"
                android:textSize="@dimen/orb_text_label" />

            <TextView
                android:id="@+id/igm_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ox_text_tertiary"
                android:textSize="@dimen/orb_text_body_s" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/igm_icon_well"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/orb_icon_tile">

            <ImageView
                android:id="@+id/igm_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <!-- The hairline IS the separator; there is no spacing between rows. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:background="@color/ox_hairline" />
</LinearLayout>
