<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — OFFLINE / LOCAL ACCOUNT  (was: a centred card stack)

  Retuned onto the window language. The live head preview becomes a framed
  VIEWPORT (a well with a hairline rim) sitting beside its identity fields in a
  single readout row, instead of a centred avatar floating above a card. The
  username rules become a proper validation READOUT — square state marks and
  mono lines — and the field is a true inset well.

  Ids preserved: header_container, ll_preview_badge, ll_identity_well,
  live_head_preview, auth_status_dot, ll_preview_name, ll_preview_hint,
  card_account_input, ll_title, ll_counter, login_edit_email (EditText),
  ll_rules, ll_rule_len_dot, ll_rule_len, ll_rule_chars_dot, ll_rule_chars,
  ll_rule_free_dot, ll_rule_free, login_button.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_pane"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/od_space_5"
        android:paddingTop="@dimen/od_space_5"
        android:paddingEnd="@dimen/od_space_5"
        android:paddingBottom="@dimen/od_space_6">

        <!-- == header == -->
        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/OdText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline account"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/ll_preview_badge"
                style="@style/OdText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_1"
                android:text="Local profile"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- == readout row: live head viewport beside the identity fields == -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_4"
            android:background="@drawable/od_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/od_space_3">

            <FrameLayout
                android:id="@+id/ll_identity_well"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/od_well">

                <ImageView
                    android:id="@+id/live_head_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/auth_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/od_live_dot" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ll_preview_name"
                    style="@style/OdText.TitleM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Player"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/ll_preview_hint"
                    style="@style/OdText.MonoS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Skins resolve locally - no server login"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>

        <!-- == the form field == -->
        <LinearLayout
            android:id="@+id/card_account_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_4"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ll_title"
                    style="@style/OdText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Username"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/ll_counter"
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/od_text_faint"
                    tools:text="0 / 16" />
            </LinearLayout>

            <EditText
                android:id="@+id/login_edit_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/od_touch_min"
                android:layout_marginTop="@dimen/od_space_2"
                android:background="@drawable/od_well"
                android:gravity="center_vertical"
                android:hint="Steve"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingStart="@dimen/od_space_3"
                android:paddingEnd="@dimen/od_space_3"
                android:textColor="@color/od_text"
                android:textColorHint="@color/od_text_faint"
                android:textSize="@dimen/od_text_body"
                tools:ignore="HardcodedText" />

            <!-- == validation readout == -->
            <LinearLayout
                android:id="@+id/ll_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_3"
                android:background="@drawable/od_well"
                android:orientation="vertical"
                android:paddingTop="@dimen/od_space_2"
                android:paddingBottom="@dimen/od_space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/od_space_3"
                    android:paddingEnd="@dimen/od_space_3">

                    <View
                        android:id="@+id/ll_rule_len_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/od_live_dot_idle" />

                    <TextView
                        android:id="@+id/ll_rule_len"
                        style="@style/OdText.MonoS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="3 - 16 characters"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/od_space_3"
                    android:paddingEnd="@dimen/od_space_3">

                    <View
                        android:id="@+id/ll_rule_chars_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/od_live_dot_idle" />

                    <TextView
                        android:id="@+id/ll_rule_chars"
                        style="@style/OdText.MonoS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="letters, numbers, underscore"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/od_space_3"
                    android:paddingEnd="@dimen/od_space_3">

                    <View
                        android:id="@+id/ll_rule_free_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/od_live_dot_idle" />

                    <TextView
                        android:id="@+id/ll_rule_free"
                        style="@style/OdText.MonoS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_2"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="not already on this launcher"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- == the action == -->
        <TextView
            android:id="@+id/login_button"
            style="@style/OdButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_touch_min"
            android:layout_marginTop="@dimen/od_space_5"
            android:gravity="center"
            android:text="Sign in"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</ScrollView>
