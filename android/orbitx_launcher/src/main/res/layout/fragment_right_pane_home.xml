<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RIGHT PANE HOME — the instance table   (was: a stack of floating cards)
  ============================================================================

  A desktop table pane: a column-header strip, a hairline, then flush rows.
  There is no wallpaper layer, no big "Profiles" banner and no per-card
  elevation — the wall of floating rounded cards is the single most copied
  idiom in this category, and it is what the redesign exists to remove.

  Ids preserved for RightPaneHomeFragment: rv_home_profiles (RecyclerView),
  fab_create_profile (View), btn_refresh_profiles (View), home_header,
  home_kicker, home_title, home_count, right_pane_wallpaper (ImageView).
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_pane"
    android:orientation="vertical">

    <!-- custom wallpaper layer (kept, hidden — the pane is a document now) -->
    <ImageView
        android:id="@+id/right_pane_wallpaper"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- == pane toolbar: title on the leading edge, actions on the trailing == -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_pane_header_h"
        android:background="@drawable/od_pane_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter">

        <TextView
            android:id="@+id/home_kicker"
            style="@style/OdText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instances" />

        <TextView
            android:id="@+id/home_title"
            style="@style/OdText.TitleS"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_count"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:background="@drawable/od_keycap"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            tools:text="4" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_refresh_profiles"
            style="@style/OdButton.Icon"
            android:contentDescription="@string/orbitx_cd_refresh"
            android:src="@drawable/ic_cs_refresh"
            app:tint="@color/od_text_dim" />

        <ImageView
            android:id="@+id/fab_create_profile"
            style="@style/OdButton.Icon"
            android:contentDescription="@string/orbitx_cd_new_instance"
            android:src="@drawable/ic_add"
            app:tint="@color/od_accent_bright" />
    </LinearLayout>

    <!-- == column header — this pane is a table and says so == -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_space_2">

        <TextView
            style="@style/OdText.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Instance" />

        <TextView
            style="@style/OdText.Label"
            android:layout_width="@dimen/od_col_meta"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Version" />

        <TextView
            style="@style/OdText.Label"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Mods" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/od_rule_strong" />

    <!-- == the rows == flush, hairline-separated, full-bleed hit area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home_profiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/od_space_4"
        android:scrollbars="none" />
</LinearLayout>
