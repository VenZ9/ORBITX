<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CS PICKER SHEET (Phase 9) — generic single-choice popup used by the
     profile editor for Java runtime + renderer selection.
     Structure: glyph well · kicker/title · closing pill │ divider │
                option rows (glyph · title · mono meta · check) │ footer hint
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pk_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/od_pane_raised"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/pk_glyph_well"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/od_well">

            <TextView
                android:id="@+id/pk_glyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="monospace"
                android:text="J"
                android:textColor="@color/od_text"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pk_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="SELECT"
                android:textColor="@color/od_text_muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/pk_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="Java runtime"
                android:textColor="@color/od_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/pk_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Which JVM launches this profile"
                android:textColor="@color/od_text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pk_close"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/pk_close_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="ESC"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:textColor="@color/od_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#382B2C" />

    <!-- rows -->
    <ScrollView
        android:id="@+id/pk_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="20dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pk_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <TextView
        android:id="@+id/pk_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:text="Tap a row to select — the choice applies when you save the profile."
        android:textColor="@color/od_text_muted"
        android:textSize="10.5sp" />
</LinearLayout>
