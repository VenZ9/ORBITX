<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  BROWSE RESOURCES — toolbar + tab strip over the results pane
  ============================================================================

  Retuned onto the ORBIT Desktop language. The structure was already flat, so
  this pass is about making the chrome read as part of the window rather than
  as a page header:

    - the header sits on the command-bar surface with a single closing hairline,
      so the toolbar belongs to the window frame instead of floating on the page
    - the search field is a proper inset WELL (it recesses into the toolbar, it
      does not sit on top of it)
    - the tab strip and the sort control are brand chips in the od_chip style,
      so "selected" is an ember rim rather than a coloured fill
    - all radii drop to the sharp end of the scale, matching the rest of the app

  No ids change, and the two zero-size logic hosts (search_button_go and
  tab_indicator) are preserved exactly as they were.
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_pane"
    android:orientation="vertical">

    <!-- == TOOLBAR (fixed, never scrolls away) == -->
    <LinearLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/od_commandbar"
        android:orientation="vertical"
        android:paddingStart="@dimen/od_space_2"
        android:paddingEnd="@dimen/od_space_2">

        <LinearLayout
            android:id="@+id/mod_store_header_collapsible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_row_h_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mod_store_back"
                style="@style/OdButton.Icon"
                android:contentDescription="@string/global_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/od_text_dim" />

            <TextView
                android:id="@+id/mod_store_title"
                style="@style/OdText.TitleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/browse_title" />

            <!-- one search well for the whole pane -->
            <LinearLayout
                android:id="@+id/search_capsule_container"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/od_space_3"
                android:layout_weight="1"
                android:background="@drawable/od_search_well"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_space_2">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/od_text_faint" />

                <EditText
                    android:id="@+id/search_mod_edittext"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/browse_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="@color/od_text"
                    android:textColorHint="@color/od_text_faint"
                    android:textSize="@dimen/od_text_body_s" />

                <ImageButton
                    android:id="@+id/search_clear_button"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:contentDescription="@string/global_clear"
                    android:padding="7dp"
                    android:src="@drawable/ic_mr_close"
                    android:visibility="gone"
                    app:tint="@color/od_text_faint" />

                <!-- zero-size logic host: keyboard action and SEARCH share one
                     code path, so the listener needs an id to bind to. -->
                <View
                    android:id="@+id/search_button_go"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/od_row_h_toolbar"
                android:layout_height="@dimen/od_row_h_toolbar">

                <ImageButton
                    android:id="@+id/search_mod_filter"
                    style="@style/OdButton.Icon"
                    android:contentDescription="@string/browse_filter_cd"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/od_text_dim" />

                <View
                    android:id="@+id/search_mod_filter_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/od_live_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- == tab strip and sort control, one row == -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/tab_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tab_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:id="@+id/tab_indicator"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/sort_chip_scroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/od_space_2"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sort_chip_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/od_rule_strong" />
    </LinearLayout>

    <!-- == results pane + page-level progress rule == -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/download_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/browse_progress_line"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:indeterminateTint="@color/od_accent"
            android:progressBackgroundTint="#00000000"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
