<?xml version="1.0" encoding="utf-8"?>
<!-- Controls editor — SAVE LAYOUT sheet (Clean Console, animated) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/pe4_icon_well">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="@color/od_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="CONTROL EDITOR"
                android:textColor="@color/od_text_muted"
                android:textSize="7.5sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/global_save"
                android:textColor="@color/od_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.14"
        android:text="LAYOUT NAME"
        android:textColor="@color/od_text_muted"
        android:textSize="7.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/css_name_input"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/od_well"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="13dp"
        android:singleLine="true"
        android:textColor="@color/od_text"
        android:textColorHint="@color/od_text_faint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/css_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/od_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@android:string/cancel"
            android:textAllCaps="true"
            android:textColor="@color/od_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/css_btn_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/od_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/global_save"
            android:textAllCaps="true"
            android:textColor="@color/od_on_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/css_btn_save_exit"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/od_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/global_save_and_exit"
        android:textAllCaps="true"
        android:textColor="@color/od_on_accent"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
