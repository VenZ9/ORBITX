<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_fastclient_loading"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/od_space_8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_loading_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/orbitx_mark"
            android:scaleType="fitCenter"
            android:contentDescription="ORBITX"
            android:layout_marginBottom="@dimen/od_space_5" />

        <TextView
            android:id="@+id/tv_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Installing FastClient..."
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_title_m"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:layout_marginBottom="@dimen/od_space_1" />

        <TextView
            android:id="@+id/tv_loading_version_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.6.2"
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_body_s"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/od_thumb" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_space_1"
            android:background="@drawable/bg_progress_track"
            android:layout_marginBottom="@dimen/od_space_2">

            <ProgressBar
                android:id="@+id/pb_fastclient_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_premium" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/od_space_5">

            <TextView
                android:id="@+id/tv_loading_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Preparing installation..."
                android:textColor="@color/od_text_dim"
                android:textSize="@dimen/od_text_mono" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/od_text"
                android:textSize="@dimen/od_text_mono"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_fastclient_branding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ FastClient · ORBITX"
        android:textColor="@color/od_text_dim"
        android:textSize="@dimen/od_text_mono"
        android:layout_marginBottom="@dimen/od_space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
