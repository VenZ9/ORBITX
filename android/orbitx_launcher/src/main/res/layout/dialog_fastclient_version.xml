<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_fastclient_version"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_fastclient"
    android:padding="@dimen/od_space_5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚀  Select FastClient Version"
        android:textColor="@color/od_text"
        android:textSize="@dimen/od_text_title_s"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/od_space_4" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="@dimen/od_space_3" />

    <RadioGroup
        android:id="@+id/rg_version_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_version_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_row_h_toolbar"
            android:text="FastClient  v1.6.2   [LATEST]"
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_body_s"
            android:checked="true"
            android:buttonTint="@color/od_text"
            android:paddingStart="@dimen/od_space_2"
            android:background="@drawable/bg_version_item_selected"
            android:layout_marginBottom="6dp" />

        <RadioButton
            android:id="@+id/rb_version_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_row_h_toolbar"
            android:text="FastClient  v1.6.1"
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_body_s"
            android:buttonTint="@color/od_text"
            android:paddingStart="@dimen/od_space_2"
            android:background="@drawable/bg_version_item_normal"
            android:layout_marginBottom="6dp" />

        <RadioButton
            android:id="@+id/rb_version_3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_row_h_toolbar"
            android:text="FastClient  v1.6.0"
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_body_s"
            android:buttonTint="@color/od_text"
            android:paddingStart="@dimen/od_space_2"
            android:background="@drawable/bg_version_item_normal"
            android:layout_marginBottom="6dp" />

        <RadioButton
            android:id="@+id/rb_version_4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_row_h_toolbar"
            android:text="FastClient  v1.5.9"
            android:textColor="@color/od_text"
            android:textSize="@dimen/od_text_body_s"
            android:buttonTint="@color/od_text"
            android:paddingStart="@dimen/od_space_2"
            android:background="@drawable/bg_version_item_normal" />

    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A"
        android:layout_marginTop="@dimen/od_space_4"
        android:layout_marginBottom="@dimen/od_gutter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btn_cancel_fastclient"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/od_space_10"
            android:text="CANCEL"
            android:textColor="@color/od_text_muted"
            android:textSize="@dimen/od_text_body_s"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/od_space_4"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="@dimen/od_space_2" />

        <TextView
            android:id="@+id/btn_install_fastclient"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/od_space_10"
            android:text="INSTALL"
            android:textColor="@color/od_on_accent"
            android:textSize="@dimen/od_text_body_s"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/od_space_6"
            android:background="@drawable/bg_btn_orange"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
