<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     MOD MANAGEMENT v5 — "Clean Console"
     Slim command bar + cascading mod list + animated empty state.
     All ManageModsFragment IDs and widget types preserved.
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/od_window_bg">

    <!-- ── COMMAND BAR ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/manage_mods_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/od_commandbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/manage_mods_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/od_icon_button"
            android:contentDescription="@string/global_back"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#EFEAEA" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/pe4_icon_well">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                app:tint="#EEE6E6" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="PROFILE"
                android:textColor="@color/od_text_muted"
                android:textSize="7.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/manage_mods_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mcl_button_manage_mods"
                android:textColor="@color/od_text"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/manage_mods_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/od_btn_primary"
            android:contentDescription="@string/global_add"
            android:padding="9dp"
            android:src="@drawable/ic_add"
            app:tint="@color/od_on_accent" />
    </LinearLayout>

    <!-- ── MOD LIST (cascade entrance) ─────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/manage_mods_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/cz_cascade"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:scrollbars="none" />

    <!-- ── EMPTY STATE ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/manage_mods_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/pe4_icon_ring"
            android:padding="2dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                app:tint="@color/od_text_muted" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/manage_mods_empty"
            android:textColor="@color/od_text_muted"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Tap the + button to browse and install mods."
            android:textColor="@color/od_text_faint"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
