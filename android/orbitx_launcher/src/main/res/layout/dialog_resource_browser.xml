<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — RESOURCE BROWSER  (in-launcher content panel)

  Retuned onto the window language so the in-launcher browser matches the rest
  of the shell: a panel with a title strip (identity + close), a tab strip of
  brand chips, a search WELL, an optional notification line, and a flush
  results list in the od_well background.

  Ids preserved for the fragment: cs_rb_subtitle, cs_rb_close, cs_rb_tab_packs,
  cs_rb_tab_shaders, cs_rb_search_input (EditText), cs_rb_search_clear,
  cs_rb_search_btn, cs_rb_version_note, cs_rb_list (RecyclerView),
  cs_rb_loading (ProgressBar), cs_rb_empty.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/od_panel"
    android:orientation="vertical">

    <!-- == TITLE STRIP == -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_panel_title_h"
        android:background="@drawable/od_panel_titlebar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_space_1">

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/od_bitmap_frame">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_browser_resources"
                app:tint="@color/od_accent_bright" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/OdText.TitleS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="RESOURCES"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/cs_rb_subtitle"
                style="@style/OdText.MonoS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/od_text_faint"
                tools:text="Modrinth" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/cs_rb_close"
            style="@style/OdButton.Icon"
            android:contentDescription="@string/global_close"
            android:src="@drawable/ic_mr_close"
            app:tint="@color/od_text_dim" />
    </LinearLayout>

    <!-- == TAB STRIP + SEARCH == -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_gutter">

        <TextView
            android:id="@+id/cs_rb_tab_packs"
            style="@style/OdButton.Chip"
            android:layout_width="wrap_content"
            android:text="Resource packs"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/cs_rb_tab_shaders"
            style="@style/OdButton.Chip"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:text="Shaders"
            tools:ignore="HardcodedText" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="30dp"
            android:background="@drawable/od_search_well"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/od_space_2">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/od_text_faint" />

            <EditText
                android:id="@+id/cs_rb_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/browse_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/od_text"
                android:textColorHint="@color/od_text_faint"
                android:textSize="@dimen/od_text_body_s" />

            <ImageView
                android:id="@+id/cs_rb_search_clear"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/global_clear"
                android:padding="6dp"
                android:src="@drawable/ic_mr_close"
                android:visibility="gone"
                app:tint="@color/od_text_faint" />

            <ImageButton
                android:id="@+id/cs_rb_search_btn"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:contentDescription="@string/browse_search_hint"
                android:padding="6dp"
                android:src="@drawable/ic_search"
                app:tint="@color/od_accent_bright" />
        </LinearLayout>
    </LinearLayout>

    <!-- == optional version / notification line == -->
    <TextView
        android:id="@+id/cs_rb_version_note"
        style="@style/OdText.MonoS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/od_statusstrip"
        android:paddingStart="@dimen/od_gutter"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/od_gutter"
        android:paddingBottom="6dp"
        android:textColor="@color/od_text_muted"
        android:visibility="gone"
        tools:text="Filtered for 1.21 - Fabric" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/od_rule_strong" />

    <!-- == RESULTS == -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cs_rb_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/od_well"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/cs_rb_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:indeterminateTint="@color/od_accent"
            android:progressBackgroundTint="#00000000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cs_rb_empty"
            style="@style/OdText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/browse_no_results"
            android:textColor="@color/od_text_muted"
            android:textSize="@dimen/od_text_body_s"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
