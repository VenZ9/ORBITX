<?xml version="1.0" encoding="utf-8"?>
<!--
     WORLD ROW  (was: a rounded "glass card" with a chip row under it)

     Was a card: a rounded surface, an 8dp bottom margin, a 46dp art tile beside
     the name and meta, an overflow button, and a SECOND line of rounded chips
     (size, datapack count) below it. Three visual layers to express one world.

     A row that carries its facts in ALIGNED COLUMNS lets you compare four worlds
     by running your eye down the page. One that carries them in chips under
     itself cannot be compared with the row above it at all.

     It is now one 56dp table row, flush, hairline-separated by the list:

         > [art] My Survival Base   1.20.1 . 2d ago   842 MB   ...
                 ^ name / meta       ^ when           ^ size   ^ actions

     The size moves OUT of a chip and INTO a right-aligned mono column, which is
     the whole point: every world's size now sits on the same vertical line. The
     datapack chip stays as a mono column too, so it still has somewhere to
     render when the adapter shows it.

     Every id WorldListAdapter binds is preserved: world_icon, world_name,
     world_meta, world_menu_button, world_size_chip, world_datapack_chip.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/OdRow.TallSelectable"
    android:layout_width="match_parent">

    <!-- the row's own rule. Drawn by the row, not by the list, so the last row
         can suppress it. -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="36dp"
        android:background="@drawable/od_bitmap_frame">

        <ImageView
            android:id="@+id/world_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cs_world_icon_desc"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/avatars" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/od_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/world_name"
            style="@style/OdText.TitleS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="My Survival Base" />

        <TextView
            android:id="@+id/world_meta"
            style="@style/OdText.MonoS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="1.20.1  .  2d ago" />
    </LinearLayout>

    <!-- the size, as a right-aligned mono column: every row's size lands on the
         same vertical line, which is what makes the list scannable. -->
    <TextView
        android:id="@+id/world_size_chip"
        style="@style/OdText.Mono"
        android:layout_width="@dimen/od_col_meta"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        tools:text="842 MB" />

    <TextView
        android:id="@+id/world_datapack_chip"
        style="@style/OdText.MonoS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/od_space_2"
        android:maxLines="1"
        android:visibility="gone"
        tools:text="3 DP" />

    <ImageButton
        android:id="@+id/world_menu_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/od_space_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cs_world_actions"
        android:padding="7dp"
        android:src="@drawable/ic_cs_more"
        app:tint="@color/od_text_muted" />
</LinearLayout>
