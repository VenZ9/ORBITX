<?xml version="1.0" encoding="utf-8"?>
<!--
     WORLD MANAGER  (was: a "Clean Console" page of graphite cards)

     It replaces a phone page wearing console colours: a 52dp rounded top bar,
     then TWO rounded cards side by side (storage meter / search over four
     rounded sort chips), then a cascading list of rounded world cards. Two
     cards side by side, each with its own radius and its own interior padding,
     is the clearest tell that a layout was composed on a phone and recoloured
     later: three different left edges on one screen.

     It is now a WINDOW PANE with exactly one left edge:

         [ pane header 46dp ]  <-  SINGLEPLAYER / World Manager   [12][R][IMPORT]
         [ readout row 40dp ]  STORAGE  4.2 GB / 32 GB  [=======]
         [ toolbar 44dp     ]  [ search worlds ] RECENT NAME SIZE VERSION
         [ 56dp row         ]  My Survival Base  1.20.1 2d ago  842 MB  ...
         [ 1dp rule         ]
         [ status strip 26dp]  12 worlds   RECENT . NAME . SIZE . VERSION

       - the two cards merge into two flush STRIPS: storage and search share the
         pane's single left edge and are separated by hairlines, not gutters
       - sort becomes a segmented control at the trailing edge of the search
         row, where a browser puts it, not four chips on their own line
       - the storage meter becomes a labelled readout with the figure beside
         the label, so the number reads without measuring a bar
       - the command bar becomes the standard pane header
       - a status strip closes the pane

     Zero regression: every id WorldManagerFragment and the adapter bind is
     preserved verbatim, including _header_right_group, the datapack hint
     (still gone by default), the loading and empty state groups, and the sort
     chips. View types unchanged: world_list stays a RecyclerView and
     world_storage_bar stays a ProgressBar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/od_window_bg"
    android:orientation="vertical">

    <!-- == PANE HEADER == -->
    <LinearLayout
        style="@style/OdPaneHeader">

        <FrameLayout
            android:id="@+id/world_back_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/od_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@string/global_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/od_text_dim" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/world_subtitle"
                style="@style/OdText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SINGLEPLAYER"
                tools:ignore="HardcodedText" />

            <TextView
                style="@style/OdText.TitleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="World Manager"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/_header_right_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/world_count_chip"
                style="@style/OdWell.Keycap"
                android:layout_width="wrap_content"
                android:minWidth="52dp"
                android:paddingStart="@dimen/od_space_2"
                android:paddingEnd="@dimen/od_space_2"
                android:text="0 WORLDS"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:id="@+id/world_datapack_hint_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="@dimen/od_space_2"
                android:background="@drawable/od_icon_button"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    style="@style/OdText.MonoS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="DP"
                    tools:ignore="HardcodedText" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/world_refresh_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="@dimen/od_space_2"
                android:background="@drawable/od_icon_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/world_refresh_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cs_refresh"
                    app:tint="@color/od_text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/world_import_button"
                style="@style/OdButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/od_space_2"
                android:minHeight="0dp"
                android:text="Import"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <!-- == STORAGE READOUT == one flush strip: label, the figure, the meter.
         The number sits beside the label so it reads without measuring a bar. == -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_gutter">

        <TextView
            style="@style/OdText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STORAGE"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/world_storage_used"
            style="@style/OdText.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_3"
            android:text="-"
            tools:ignore="HardcodedText" />

        <ProgressBar
            android:id="@+id/world_storage_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="@dimen/od_space_3"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/od_progress" />

        <TextView
            android:id="@+id/world_storage_summary"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_3"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Worlds on this profile"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/world_storage_free"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:text="" />

        <TextView
            android:id="@+id/world_storage_total"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_1"
            android:text="" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_stroke_rule"
        android:background="@color/od_rule" />

    <!-- == TOOLBAR == search well on the leading edge, sort as a segmented
         control on the trailing edge - where a browser keeps it. == -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_row_h_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_space_2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/od_search_well"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/od_space_2">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/od_text_faint" />

            <EditText
                android:id="@+id/world_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Search worlds..."
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/od_text"
                android:textColorHint="@color/od_text_faint"
                android:textSize="@dimen/od_text_body_s"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Sort: one segmented control, so the four states read as one
             instrument instead of four separate buttons. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="@dimen/od_space_3"
            android:background="@drawable/od_chip"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/world_sort_last_played"
                style="@style/OdText.Label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/od_chip"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="@dimen/od_space_2"
                android:paddingEnd="@dimen/od_space_2"
                android:text="RECENT"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/world_sort_name"
                style="@style/OdText.Label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="46dp"
                android:paddingStart="@dimen/od_space_2"
                android:paddingEnd="@dimen/od_space_2"
                android:text="NAME"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/world_sort_size"
                style="@style/OdText.Label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="46dp"
                android:paddingStart="@dimen/od_space_2"
                android:paddingEnd="@dimen/od_space_2"
                android:text="SIZE"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/world_sort_version"
                style="@style/OdText.Label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingStart="@dimen/od_space_2"
                android:paddingEnd="@dimen/od_space_2"
                android:text="VERSION"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_stroke_rule"
        android:background="@color/od_rule" />

    <!-- == LIST == -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/world_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/cz_cascade"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/od_space_1"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/world_loading_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                style="@style/OdText.MonoS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                android:text="Scanning worlds..."
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/world_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/od_well">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="*"
                    android:textColor="@color/od_text_faint"
                    android:textSize="20sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/world_empty_text"
                style="@style/OdText.BodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_3"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="No worlds here yet.\nPlay this profile once, or import a .zip / .mcworld above."
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </FrameLayout>

    <!-- == STATUS STRIP == -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_status_h"
        android:background="@drawable/od_statusstrip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/od_gutter"
        android:paddingEnd="@dimen/od_gutter">

        <View
            android:layout_width="@dimen/od_status_dot"
            android:layout_height="@dimen/od_status_dot"
            android:background="@drawable/od_live_dot" />

        <TextView
            style="@style/OdChrome.StatusCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:layout_weight="1"
            android:text="WORLDS"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/OdChrome.StatusCell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECENT . NAME . SIZE . VERSION"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>
