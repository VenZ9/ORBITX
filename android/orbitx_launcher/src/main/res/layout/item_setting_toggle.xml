<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — one settings ROW (toggle). 48dp, flush, full-bleed hit area.
     ids preserved: setting_icon, setting_title, setting_summary,
     setting_fav_star, setting_toggle (CustomToggleView — its class and size are
     unchanged because it draws its own track and thumb). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/od_row_h"
    android:background="@drawable/od_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/od_gutter"
    android:paddingEnd="@dimen/od_space_3">

    <ImageView
        android:id="@+id/setting_icon"
        android:layout_width="@dimen/od_row_glyph"
        android:layout_height="@dimen/od_row_glyph"
        android:layout_marginEnd="@dimen/od_space_3"
        android:contentDescription="@null"
        android:src="@drawable/ic_menu_settings"
        app:tint="@color/od_text_muted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/od_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setting_title"
            style="@style/OdText.TitleS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/od_text_body"
            tools:text="Force English" />

        <TextView
            android:id="@+id/setting_summary"
            style="@style/OdText.MonoS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Always run the interface in English" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/setting_fav_star"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@null"
        android:contentDescription="@null"
        android:src="@drawable/ic_csp_star_outline"
        android:visibility="gone" />

    <net.kdt.pojavlaunch.prefs.CustomToggleView
        android:id="@+id/setting_toggle"
        android:layout_width="52dp"
        android:layout_height="30dp" />
</LinearLayout>
