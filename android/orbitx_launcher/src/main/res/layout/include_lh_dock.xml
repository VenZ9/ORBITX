<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════════
  ORBIT — the navigation rail (shared by every launcher page)
  ══════════════════════════════════════════════════════════════════════════

  Five destinations, top-aligned and evenly spaced, in a flat obsidian panel.
  The rail is sized off the ORBIT 4dp grid (72dp wide, 44dp targets) and the
  active destination is rendered by `bg_hd_sidebar_item` — see that file for
  the selection language.

  IDs are unchanged from the previous shell (lh_nav_home / _cursor / _controls
  / _about / _settings) so LauncherActivity's binding and selection logic keeps
  working untouched: this is a restyle, not a re-wiring.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lh_dock"
    android:layout_width="@dimen/orb_rail_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/orb_space_2"
    android:background="@drawable/bg_lh_glass"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/orb_space_3"
    android:paddingBottom="@dimen/orb_space_3">

    <!-- Product mark: the orbit ring, anchoring the top of the rail. -->
    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="@dimen/orb_space_3"
        android:contentDescription="@string/app_name"
        android:src="@drawable/orbitx_mark" />

    <View
        android:layout_width="28dp"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/orb_space_3"
        android:background="@color/ox_hairline" />

    <FrameLayout
        android:id="@+id/lh_nav_home"
        android:layout_width="@dimen/orb_rail_item_w"
        android:layout_height="@dimen/orb_rail_item_h"
        android:background="@drawable/bg_hd_sidebar_item"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="@dimen/orb_rail_icon"
            android:layout_height="@dimen/orb_rail_icon"
            android:layout_gravity="center"
            android:contentDescription="Home"
            android:src="@drawable/ic_menu_home"
            app:tint="@color/orb_rail_icon_tint" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lh_nav_cursor"
        android:layout_width="@dimen/orb_rail_item_w"
        android:layout_height="@dimen/orb_rail_item_h"
        android:layout_marginTop="@dimen/orb_space_1"
        android:background="@drawable/bg_hd_sidebar_item"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="@dimen/orb_rail_icon"
            android:layout_height="@dimen/orb_rail_icon"
            android:layout_gravity="center"
            android:contentDescription="Cursor"
            android:src="@drawable/ic_mouse_pointer"
            app:tint="@color/orb_rail_icon_tint" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lh_nav_controls"
        android:layout_width="@dimen/orb_rail_item_w"
        android:layout_height="@dimen/orb_rail_item_h"
        android:layout_marginTop="@dimen/orb_space_1"
        android:background="@drawable/bg_hd_sidebar_item"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="@dimen/orb_rail_icon"
            android:layout_height="@dimen/orb_rail_icon"
            android:layout_gravity="center"
            android:contentDescription="Controls"
            android:src="@drawable/ic_menu_custom_controls"
            app:tint="@color/orb_rail_icon_tint" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lh_nav_about"
        android:layout_width="@dimen/orb_rail_item_w"
        android:layout_height="@dimen/orb_rail_item_h"
        android:layout_marginTop="@dimen/orb_space_1"
        android:background="@drawable/bg_hd_sidebar_item"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="@dimen/orb_rail_icon"
            android:layout_height="@dimen/orb_rail_icon"
            android:layout_gravity="center"
            android:contentDescription="About"
            android:src="@drawable/ic_info"
            app:tint="@color/orb_rail_icon_tint" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lh_nav_settings"
        android:layout_width="@dimen/orb_rail_item_w"
        android:layout_height="@dimen/orb_rail_item_h"
        android:layout_marginTop="@dimen/orb_space_1"
        android:background="@drawable/bg_hd_sidebar_item"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="@dimen/orb_rail_icon"
            android:layout_height="@dimen/orb_rail_icon"
            android:layout_gravity="center"
            android:contentDescription="Settings"
            android:src="@drawable/ic_menu_settings"
            app:tint="@color/orb_rail_icon_tint" />
    </FrameLayout>
</LinearLayout>
