<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════════════
  ORBIT — the command bar (shared by every launcher page)
  ══════════════════════════════════════════════════════════════════════════════

  This is the whole navigation model. ORBIT does NOT use a left-hand icon rail,
  a top header bar, a drawer, or a floating gear button. Instead every
  destination lives in ONE flat band pinned to the bottom edge — the strip of
  screen a thumb already rests on when the phone is held one-handed.

  WHY THE BOTTOM BAND

  A left rail is a desktop pattern: it costs ~72dp of width on every screen
  (a sixth of a 360dp portrait viewport) to hold five small glyphs, and it puts
  the targets in the hardest-to-reach corner. A bottom band is reachable, costs
  height rather than width (the axis that matters for a game launcher showing a
  list of instances), and lets the content pane own the full top of the page —
  which is what lets a title run edge to edge.

  HOW STATE IS SHOWN — a rule, not a box

  The active destination grows a 2dp ember rule along its TOP edge: the seam
  between the page above and the bar below. Selection therefore reads as a line
  pointing up into the screen you are on. Nothing is ever filled as a capsule,
  so the bar stays flat and exactly one thing on it is coloured.

  LEGACY IDS

  lh_dock and lh_nav_home / _cursor / _controls / _about are unchanged, so
  LauncherActivity's binding and its setSelected()-driven selection logic keeps
  working untouched. account_spinner and setting_button are retained as
  zero-size logic hosts (see below); they render nothing.
  ══════════════════════════════════════════════════════════════════════════════
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lh_dock"
    android:layout_width="match_parent"
    android:layout_height="@dimen/orb_bar_height"
    android:background="@drawable/orb_bar_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/orb_space_1"
    android:paddingEnd="@dimen/orb_space_1">

    <!-- ── Product tile ────────────────────────────────────────────────────
         The app mark, sitting in the corner where a launcher would normally
         put a hamburger. It anchors the bar's identity and doubles as the host
         for the account spinner, which lives here as a zero-size ghost so
         mcAccountSpinner (and the account chip on Home) keeps resolving
         R.id.account_spinner exactly as before. -->
    <FrameLayout
        android:layout_width="@dimen/orb_bar_brand_tile"
        android:layout_height="@dimen/orb_bar_brand_tile"
        android:layout_marginStart="@dimen/orb_space_1"
        android:background="@drawable/orb_bar_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/orb_bar_brand_glyph"
            android:layout_height="@dimen/orb_bar_brand_glyph"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/orbitx_mark" />

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:dropDownWidth="280dp"
            android:popupBackground="@drawable/bg_account_popup"
            android:popupElevation="10dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Seam between the identity field and the destinations. -->
    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/orb_space_2"
        android:background="@color/ox_hairline" />

    <!-- ── Destination: Home ───────────────────────────────────────────────
         Each destination is a column — glyph over a tracked-out uppercase
         label — sharing the band evenly via layout_weight. -->
    <LinearLayout
        android:id="@+id/lh_nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/orb_bar_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/lh_nav_home_glyph"
            android:layout_width="@dimen/orb_bar_glyph"
            android:layout_height="@dimen/orb_bar_glyph"
            android:contentDescription="@null"
            android:src="@drawable/ic_menu_home"
            app:tint="@color/orb_rail_icon_tint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orb_space_1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="@dimen/orb_text_label_tracking"
            android:text="HOME"
            android:textColor="@color/orb_bar_label_tint"
            android:textSize="@dimen/orb_text_label_xs" />
    </LinearLayout>

    <!-- ── Destination: Cursor ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/lh_nav_cursor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/orb_bar_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/lh_nav_cursor_glyph"
            android:layout_width="@dimen/orb_bar_glyph"
            android:layout_height="@dimen/orb_bar_glyph"
            android:contentDescription="@null"
            android:src="@drawable/ic_mouse_pointer"
            app:tint="@color/orb_rail_icon_tint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orb_space_1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="@dimen/orb_text_label_tracking"
            android:text="CURSOR"
            android:textColor="@color/orb_bar_label_tint"
            android:textSize="@dimen/orb_text_label_xs" />
    </LinearLayout>

    <!-- ── Destination: Controls ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/lh_nav_controls"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/orb_bar_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/lh_nav_controls_glyph"
            android:layout_width="@dimen/orb_bar_glyph"
            android:layout_height="@dimen/orb_bar_glyph"
            android:contentDescription="@null"
            android:src="@drawable/ic_menu_custom_controls"
            app:tint="@color/orb_rail_icon_tint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orb_space_1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="@dimen/orb_text_label_tracking"
            android:text="CONTROLS"
            android:textColor="@color/orb_bar_label_tint"
            android:textSize="@dimen/orb_text_label_xs" />
    </LinearLayout>

    <!-- ── Destination: About ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/lh_nav_about"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/orb_bar_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/lh_nav_about_glyph"
            android:layout_width="@dimen/orb_bar_glyph"
            android:layout_height="@dimen/orb_bar_glyph"
            android:contentDescription="@null"
            android:src="@drawable/ic_info"
            app:tint="@color/orb_rail_icon_tint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orb_space_1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="@dimen/orb_text_label_tracking"
            android:text="ABOUT"
            android:textColor="@color/orb_bar_label_tint"
            android:textSize="@dimen/orb_text_label_xs" />
    </LinearLayout>

    <!-- ── Legacy logic host ───────────────────────────────────────────────
         mSettingsButton swaps this icon's drawable on fragment changes and
         wires its click to the legacy settings handler. Settings is reached
         from the Home screen, so the button itself is not part of the bar; it
         is kept at zero size and gone so that Java keeps working. -->
    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Settings"
        android:src="@drawable/ic_menu_settings"
        android:visibility="gone" />
</LinearLayout>
