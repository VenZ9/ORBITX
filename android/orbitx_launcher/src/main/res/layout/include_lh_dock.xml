<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT DESKTOP — the command bar  (replaces the bottom icon band)

  THE STRUCTURAL CHANGE

  The band this replaces sat on the BOTTOM edge and stacked a glyph over a label
  inside five equal columns — the home-screen idiom every phone launcher uses.
  That is why the app kept reading as a re-skin no matter what colour it was.

  This is a desktop MENU BAR: pinned to the TOP edge, built from two tiers.

     +==========================================================+
     | [mark] ORBITX  .            EN v  build  [@ player]      |  title strip
     +==========================================================+
     |   HOME   |  CURSOR  | CONTROLS |  ABOUT  |  SETTINGS     |  nav strip
     |   =====  |          |          |         |               |
     +==========================================================+

  TIER 1 — THE TITLE STRIP, 32dp.

  Product identity on the leading edge; the utility cluster on the trailing
  edge. This is a window's own title bar: who this is, on the left; the controls
  that act on the whole window, on the right. The build id and the account chip
  live here rather than on a page, because they are global facts, not
  per-destination ones.

  TIER 2 — THE NAV STRIP, 56dp.

  Every destination as a centred column: glyph above caption, with a 2dp accent
  rule under the caption when it is the page you are on. That underline is the
  most recognisable element of the design this is built to, and it is what makes
  the current location legible WITHOUT the caption changing colour — a colour-
  only active state disappears on a dim panel.

  The two tiers are separated by a hairline and the whole bar is closed by a
  second one where it meets the workspace. Nothing floats, nothing is a capsule.

  HOW THE ACTIVE DESTINATION READS

  A 2dp accent rule under the caption — pointing DOWN into the workspace, the
  same grammar the segmented tabs and the row-selection marker use, so an accent
  rule always points at the thing it controls. Plus a raised fill on the column.
  Two signals, so the current page survives low brightness and colour-blindness,
  and nothing else on the bar is ever coloured.

  The underline is driven by @drawable/od_nav_underline, a state selector, so
  the parent's setSelected() lights it with no Java change. It is a selector and
  not a shape with visibility="invisible" because android:visibility does NOT
  propagate through duplicateParentState — only states do, and an invisible view
  would have stayed invisible forever.

  LEGACY IDS: lh_dock, lh_nav_home/_cursor/_controls/_about/_settings and every
  *_glyph id are unchanged, as are the account_spinner and setting_button
  zero-size logic hosts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lh_dock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/od_commandbar"
    android:orientation="vertical">

    <!-- ══════════ TIER 1 · TITLE STRIP ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- identity: the mark and the wordmark, exactly as a window titles
             itself. This is also the host for the account spinner ghost. -->
        <LinearLayout style="@style/OdBrand">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/orbitx_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:text="ORBITX"
                android:textColor="@color/od_accent"
                android:textSize="@dimen/od_text_body_s" />

            <!-- one always-visible live marker: the client is running. -->
            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="@dimen/od_space_2"
                android:background="@drawable/od_live_dot" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- ──── utility cluster: the controls that act on the whole window ──── -->

        <!-- language / locale. A text cell, because two letters do not need a
             glyph, and the chevron is the framework's own so it can never be a
             missing resource. -->
        <LinearLayout
            android:id="@+id/lh_dock_util_lang"
            style="@style/OdUtility">

            <TextView
                style="@style/OdText.MonoS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN"
                android:textColor="@color/od_text_dim" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@null"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/od_text_muted" />
        </LinearLayout>

        <!-- build identity, mono: a desktop client always shows its build. -->
        <TextView
            android:id="@+id/lh_dock_build"
            style="@style/OdText.MonoS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_2"
            android:letterSpacing="0.06"
            android:text="ORBITX"
            android:textColor="@color/od_text_faint" />

        <!-- the account chip: the global identity control. -->
        <LinearLayout
            android:id="@+id/lh_dock_account"
            style="@style/OdUtility"
            android:layout_marginStart="@dimen/od_space_2"
            android:background="@drawable/od_inner_row">

            <ImageView
                android:id="@+id/lh_dock_account_head"
                android:layout_width="@dimen/od_avatar_xs"
                android:layout_height="@dimen/od_avatar_xs"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/lh_dock_account_name"
                style="@style/OdText.MonoS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_2"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/od_text"
                android:textSize="@dimen/od_text_label" />
        </LinearLayout>

        <!-- Legacy logic host: settings icon swap target. Zero size, gone. -->
        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="Settings"
            android:src="@drawable/ic_menu_settings"
            android:visibility="gone" />

        <!-- Legacy logic host: account dialog host. Zero size, gone. -->
        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:dropDownWidth="280dp"
            android:popupBackground="@drawable/bg_account_popup"
            android:popupElevation="10dp"
            android:visibility="gone" />

        <View
            android:layout_width="@dimen/od_space_3"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- hairline between the title strip and the nav strip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/od_rule" />

    <!-- ══════════ TIER 2 · NAV STRIP ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/od_nav_h"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- === HOME === -->
        <LinearLayout
            android:id="@+id/lh_nav_home"
            style="@style/OdNavItem"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/lh_nav_home_glyph"
                android:layout_width="@dimen/od_nav_glyph"
                android:layout_height="@dimen/od_nav_glyph"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_menu_home"
                app:tint="@color/od_menuitem_glyph" />

            <TextView
                style="@style/OdNavItem.Text"
                android:text="HOME" />

            <View style="@style/OdNavItem.Underline" />
        </LinearLayout>

        <!-- === CURSOR === -->
        <LinearLayout
            android:id="@+id/lh_nav_cursor"
            style="@style/OdNavItem"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/lh_nav_cursor_glyph"
                android:layout_width="@dimen/od_nav_glyph"
                android:layout_height="@dimen/od_nav_glyph"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_mouse_pointer"
                app:tint="@color/od_menuitem_glyph" />

            <TextView
                style="@style/OdNavItem.Text"
                android:text="CURSOR" />

            <View style="@style/OdNavItem.Underline" />
        </LinearLayout>

        <!-- === CONTROLS === -->
        <LinearLayout
            android:id="@+id/lh_nav_controls"
            style="@style/OdNavItem"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/lh_nav_controls_glyph"
                android:layout_width="@dimen/od_nav_glyph"
                android:layout_height="@dimen/od_nav_glyph"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_menu_custom_controls"
                app:tint="@color/od_menuitem_glyph" />

            <TextView
                style="@style/OdNavItem.Text"
                android:text="CONTROLS" />

            <View style="@style/OdNavItem.Underline" />
        </LinearLayout>

        <!-- === ABOUT === -->
        <LinearLayout
            android:id="@+id/lh_nav_about"
            style="@style/OdNavItem"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/lh_nav_about_glyph"
                android:layout_width="@dimen/od_nav_glyph"
                android:layout_height="@dimen/od_nav_glyph"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_info"
                app:tint="@color/od_menuitem_glyph" />

            <TextView
                style="@style/OdNavItem.Text"
                android:text="ABOUT" />

            <View style="@style/OdNavItem.Underline" />
        </LinearLayout>

        <!-- === SETTINGS ===
             Kept in the nav strip, where a desktop application always puts
             preferences. The id must stay lh_nav_settings: LauncherActivity
             resolves it for both the click handler and the selected-state
             refresh. -->
        <LinearLayout
            android:id="@+id/lh_nav_settings"
            style="@style/OdNavItem"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/lh_nav_settings_glyph"
                android:layout_width="@dimen/od_nav_glyph"
                android:layout_height="@dimen/od_nav_glyph"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_menu_settings"
                app:tint="@color/od_menuitem_glyph" />

            <TextView
                style="@style/OdNavItem.Text"
                android:text="SETTINGS" />

            <View style="@style/OdNavItem.Underline" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
