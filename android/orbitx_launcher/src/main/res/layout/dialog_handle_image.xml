<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dhi_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_editor_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="SETTINGS BUTTON IMAGE"
        android:textColor="@color/od_text"
        android:textSize="12.5sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Icon shown on the floating settings handle"
        android:textColor="@color/od_text_muted"
        android:textSize="8.5sp" />

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_hud_layout_pill">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu_settings"
            app:tint="@color/od_text"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dhi_reset"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_layout_pill"
            android:clickable="true" android:focusable="true"
            android:gravity="center"
            android:text="RESET DEFAULT"
            android:textColor="@color/od_text" android:textSize="10sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/dhi_pick"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/od_chip"
            android:clickable="true" android:focusable="true"
            android:gravity="center"
            android:text="PICK IMAGE"
            android:textColor="@color/od_on_accent" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
