<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════════════
     ORBITX — ABOUT (v3) · "the product page, not a credits page"

     Rebuilt so the page reads as OrbitX's OWN identity:
       LEFT  identity card  — the OrbitX ring mark, wordmark, tagline and
                              the live build facts (version / id / ABI).
       RIGHT manifest       — 01 FEATURES (what OrbitX actually ships)
                              · 02 LEGAL (GPL v3, unchanged).

     Removed per product direction: the people/team cards, the lineage
     credit block, and every community link (Discord / GitHub / YouTube).
     Ids used by AboutFragment are preserved (about_*).
     ══════════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/au9_page"
    android:orientation="vertical">

    <!-- status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/au9_statusbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/about_back_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/au9_btn_ghost"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:text="←  BACK"
            android:textColor="#E6E9EF"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="ORBITX  ·  ABOUT"
            android:textColor="#8A909C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/about_version_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/au9_keycap"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="v1.0.0"
            android:textColor="#C9CED8"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- ── LEFT: identity card ── -->
        <LinearLayout
            android:id="@+id/about_hero_card"
            android:layout_width="236dp"
            android:layout_height="match_parent"
            android:background="@drawable/ab_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ab_logo_well">

                <ImageView
                    android:id="@+id/about_orbitx_logo"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/orbitx_mark" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/cs_about_name"
                android:textColor="#F4F6F9"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/cs_about_tagline"
                android:textColor="#8A909C"
                android:textSize="9sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#332B2F38" />

            <!-- Build facts — the useful part of an About page for a modded
                 launcher: exactly which build is installed. -->
            <TextView
                android:id="@+id/about_build_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="THIS BUILD"
                android:textColor="#6B7180"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="VERSION"
                    android:textColor="#6B7180"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/about_build_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textColor="#DFE3EA"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="CHANNEL"
                    android:textColor="#6B7180"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/about_build_channel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textColor="#FF6B6B"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="ABI"
                    android:textColor="#6B7180"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/about_build_abi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="arm64-v8a"
                    android:textColor="#DFE3EA"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/cs_about_footer"
                android:textColor="#4F5460"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- ── RIGHT: manifest ── -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- 01 FEATURES — what OrbitX ships (no people, no credits) -->
                <LinearLayout style="@style/AbSectionHead">
                    <TextView style="@style/AbIndex" android:text="01" />
                    <TextView android:id="@+id/about_credits_heading" style="@style/AbSectionTitle" android:text="Features" />
                    <View style="@style/AbRule" />
                    <TextView style="@style/AbSectionMeta" android:text="IN THIS BUILD" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/AbFeatureTile" android:layout_marginEnd="5dp">
                        <ImageView style="@style/AbFeatureIcon" android:src="@drawable/ic_browser_resources" />
                        <TextView style="@style/AbFeatureTitle" android:text="Modrinth browser" />
                        <TextView style="@style/AbFeatureLine" android:text="Search and install mods, resource packs and shaders in-app." />
                    </LinearLayout>

                    <LinearLayout style="@style/AbFeatureTile" android:layout_marginStart="5dp">
                        <ImageView style="@style/AbFeatureIcon" android:src="@drawable/ic_folder" />
                        <TextView style="@style/AbFeatureTitle" android:text="Instance backup" />
                        <TextView style="@style/AbFeatureLine" android:text="Export a whole instance to a single archive and restore it later." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/AbFeatureTile" android:layout_marginEnd="5dp">
                        <ImageView style="@style/AbFeatureIcon" android:src="@drawable/ic_menu_settings" />
                        <TextView style="@style/AbFeatureTitle" android:text="Bundled renderers" />
                        <TextView style="@style/AbFeatureLine" android:text="MobileGlues and LTW ship inside the app — nothing to download." />
                    </LinearLayout>

                    <LinearLayout style="@style/AbFeatureTile" android:layout_marginStart="5dp">
                        <ImageView style="@style/AbFeatureIcon" android:src="@drawable/ic_info" />
                        <TextView style="@style/AbFeatureTitle" android:text="In-game recorder" />
                        <TextView style="@style/AbFeatureLine" android:text="Record with no overlay on screen; export to MP4, WebM or GIF." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/AbFeatureTile" android:layout_marginEnd="5dp">
                        <ImageView style="@style/AbFeatureIcon" android:src="@drawable/ic_profile_player" />
                        <TextView style="@style/AbFeatureTitle" android:text="Three logins" />
                        <TextView style="@style/AbFeatureLine" android:text="Microsoft, ely.by or fully offline with a local profile." />
                    </LinearLayout>

                    <LinearLayout style="@style/AbFeatureTile" android:layout_marginStart="5dp">
                        <ImageView style="@style/AbFeatureIcon" android:src="@drawable/ic_manage_skin" />
                        <TextView style="@style/AbFeatureTitle" android:text="Low-end first" />
                        <TextView style="@style/AbFeatureLine" android:text="Corner boot console and light surfaces tuned for weaker phones." />
                    </LinearLayout>
                </LinearLayout>

                <!-- 02 LEGAL -->
                <LinearLayout style="@style/AbSectionHead">
                    <TextView style="@style/AbIndex" android:text="02" />
                    <TextView android:id="@+id/about_legal_heading" style="@style/AbSectionTitle" android:text="@string/cs_about_legal_heading" />
                    <View style="@style/AbRule" />
                    <TextView style="@style/AbSectionMeta" android:text="GPL-3.0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_legal_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ab_legal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/about_legal_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#8A909C"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
