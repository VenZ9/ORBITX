<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — command-bar glyph tint by state.
     The active glyph goes ember; at rest it is muted steel. Thin strokes need
     the brighter value to stay legible at 16dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/od_accent_bright" />
    <item android:color="@color/od_text_muted" />
</selector>
