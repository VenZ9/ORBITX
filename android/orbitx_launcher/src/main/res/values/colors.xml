    <!-- ==================================================================
         GLASS — the card layer
         ==================================================================
         The screenshots this pass is built to are made of CARDS: a block of
         content sits on a surface a shade lighter than the window, with a
         hairline rim, and a second block nests INSIDE it on a surface a shade
         lighter again. That is a three-step ladder, and it is distinct from the
         pane/splitter structure the window is built from — panes divide the
         screen, cards group the content inside a pane.

         Alpha is used rather than a flat fill so the artwork behind a card
         still reads faintly through it. That is what makes a launcher feel
         like it is sitting ON the game instead of replacing it.
    -->
    <color name="od_glass_card">#E6121214</color>
    <color name="od_glass_card_alt">#F00F0F11</color>
    <color name="od_glass_edge">#2C2C2E</color>
    <color name="od_glass_edge_soft">#1F1F22</color>

    <!-- An inner row: the block nested inside a card. One step lighter than the
         card it sits in, with the mid-grey rim the samples use. -->
    <color name="od_inner_row">#171719</color>
    <color name="od_inner_row_edge">#3A3A3C</color>
    <color name="od_inner_row_pressed">#242428</color>

    <!-- ==================================================================
         THE PRIMARY ACTION GRADIENT
         ==================================================================
         The one warm ramp in the app. It runs across the launch control only,
         so a filled ember-to-amber bar on screen always means "this starts the
         game" and can never be confused with selection. Ramp matches the Fast
         Client-style web chrome (fc-play): deep ember -> brand red -> amber. -->
    <color name="od_grad_cta_start">#C22417</color>
    <color name="od_grad_cta_mid">#E3372B</color>
    <color name="od_grad_cta_end">#FF9A3C</color>
    <color name="od_grad_cta_start_pressed">#A31D12</color>
    <color name="od_grad_cta_end_pressed">#E8802E</color>

    <!-- The hero card's accent edge: a single ember rule along the top of the
         card that carries the primary action. It ties the card to the button
         inside it without filling the whole surface. -->
    <color name="od_card_accent_edge">#E3372B</color>

