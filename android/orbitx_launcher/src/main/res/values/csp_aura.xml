<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════════════════
     ORBIT — legacy token bridge.

     These keys were originally a SECOND design language: a silver/near-white
     "aurora" accent over untinted grey surfaces, used by the Control
     Customisation drawer, the Button inspector, the Skin Wardrobe and the
     Runtime page. Two accents in one app is the single loudest tell that an
     interface is assembled rather than designed.

     Rather than rewrite the ~40 files that reference these keys, they are now
     aliases onto the ORBIT tokens: ONE accent (ember), warm obsidian surfaces,
     warm-washed hairlines and the ORBIT type tones. Selected/active states here
     now read ember exactly like they do everywhere else in the app.

     Do not add new `au_` keys. Add ORBIT tokens to values/orbit_design.xml and
     reference those instead.
     ══════════════════════════════════════════════════════════════════════════ -->
<resources>
    <!-- accent: the single ORBIT ember. -->
    <color name="au_accent">#FF3B30</color>
    <color name="au_accent_deep">#C62828</color>
    <color name="au_accent_fill">#26FF3B30</color>
    <color name="au_accent_line">#66FF3B30</color>

    <!-- ground -->
    <color name="au_page">#FF0E0B0B</color>
    <color name="au_page_glow">#12FF3B30</color>
    <color name="au_surface">#FA141010</color>

    <!-- elevations: warm, not neutral grey -->
    <color name="au_tile">#14FF3B30</color>
    <color name="au_tile_press">#26FF3B30</color>
    <color name="au_inset">#0AFFFFFF</color>
    <color name="au_line">#2A2323</color>
    <color name="au_line_strong">#3A2E2E</color>

    <!-- type: the ORBIT ladder -->
    <color name="au_text">#FFF5F5F5</color>
    <color name="au_text_mid">#FFAF9C9D</color>
    <color name="au_text_dim">#FF8A7979</color>
    <color name="au_text_faint">#FF6B5C5C</color>
    <!-- text drawn ON an ember fill must be white, never near-black -->
    <color name="au_on_accent">#FFFFFFFF</color>

    <color name="au_danger">#FFFF4444</color>
</resources>
