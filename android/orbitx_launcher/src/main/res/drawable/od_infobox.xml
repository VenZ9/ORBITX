<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — an INFO box: the explanatory block inside a panel.

     One step lighter than the panel it sits in and inset, so it reads as a
     quotation of the surrounding text rather than as another card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_infobox" />
    <stroke
        android:width="@dimen/od_stroke_rule"
        android:color="@color/od_infobox_edge" />
    <corners android:radius="@dimen/od_radius_inner" />
</shape>
