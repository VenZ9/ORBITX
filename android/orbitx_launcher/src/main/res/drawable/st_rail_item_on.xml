<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#271E1E" />
            <stroke android:width="1dp" android:color="#493B3C" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|center_vertical" android:height="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#EFE6E7" />
        </shape>
    </item>
</layer-list>