<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora command bar: glass with teal hairline. Shared with settings. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2B1B1C" android:endColor="#1E1314" />
        </shape>
    </item>
    <item android:top="55dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#40E0D4D5" android:endColor="#231B1B" />
        </shape>
    </item>
</layer-list>