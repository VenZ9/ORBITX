<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora SAVE button — teal gradient, dark text -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22000000">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#301B1C" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#D8C9CA"
                        android:endColor="#BFAEAF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#E0D4D5"
                        android:endColor="#C7B9BA" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>