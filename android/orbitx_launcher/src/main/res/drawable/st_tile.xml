<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#271E1E" />
            <stroke android:width="1dp" android:color="#5A4A4B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#1D1616" android:endColor="#151010" />
            <stroke android:width="1dp" android:color="#332627" />
        </shape>
    </item>
</selector>