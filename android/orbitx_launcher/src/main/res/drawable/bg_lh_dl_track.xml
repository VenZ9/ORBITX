<?xml version="1.0" encoding="utf-8"?>
<!-- Premium determinate progress bar for the home download card.
     Track: soft inset well. Progress: multi-stop lavender→platinum glow with
     a bright leading edge; a secondaryProgress layer carries the animated
     shimmer sweep (driven from code by animating secondaryProgress). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#381F1F" />
            <stroke android:width="0.7dp" android:color="#583333" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="5dp" />
                <solid android:color="#33E0ADAD" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="5dp" />
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#B85F5F"
                    android:centerColor="#E89B9B"
                    android:endColor="#FEF1F1" />
            </shape>
        </clip>
    </item>
</layer-list>
