<?xml version="1.0" encoding="utf-8"?>
<!-- ORBITX — the well behind the About page's ring mark: inset, dark, soft. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33292A" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#241A1B"
                android:centerColor="#171011"
                android:endColor="#100B0B" />
        </shape>
    </item>
</layer-list>
