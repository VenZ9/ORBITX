<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#2E2324" />
            <stroke android:width="1dp" android:color="#D8C9CA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#231B1B" android:endColor="#191414" />
            <stroke android:width="1dp" android:color="#3B2F2F" />
        </shape>
    </item>
</selector>