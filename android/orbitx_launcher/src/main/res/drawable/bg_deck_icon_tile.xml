<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — icon tile. Was a teal-glass gradient (the last off-brand hue in the
     app); now a flat obsidian tile so it belongs to the same system as every
     other container. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ox_surface" />
    <stroke android:width="1dp" android:color="@color/ox_hairline" />
    <corners android:radius="14dp" />
</shape>
