<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8 file picker: centred graphite card (all corners), silver hairline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#251C1C" android:endColor="#181010" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#443637" />
        </shape>
    </item>
</layer-list>
