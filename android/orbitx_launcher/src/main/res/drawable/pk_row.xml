<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#332627" />
            <stroke android:width="1dp" android:color="#D8C9CA" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#2E2324" />
            <stroke android:width="1dp" android:color="#493B3C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#201818" />
            <stroke android:width="1dp" android:color="#382B2C" />
        </shape>
    </item>
</selector>
