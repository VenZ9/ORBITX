<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#332627" />
            <stroke android:width="1dp" android:color="#5A4A4B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#261D1D" android:endColor="#1C1515" />
            <stroke android:width="1dp" android:color="#382B2C" />
        </shape>
    </item>
</selector>
