<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — an inset well.
     DARKER than the pane it sits in, with a hairline rim. This is the single
     most load-bearing shape in the language: anywhere the interface holds a
     value the user reads or types (a field, a stat block, a mono readout) it
     goes DOWN into a well. Panels come up, wells go down. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_well" />
    <stroke android:width="1dp" android:color="@color/od_well_edge" />
    <corners android:radius="@dimen/od_radius_sm" />
</shape>
