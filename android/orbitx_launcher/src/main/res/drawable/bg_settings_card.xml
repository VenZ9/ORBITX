<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — settings block. Flat raised surface, warm hairline, 14dp.
     Was a pink-to-black gradient with a cool-grey stroke: two clashing
     temperature signals on one card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ox_surface" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/ox_hairline" />
</shape>
