<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — the icon well in a card row.

     A soft-cornered square that frames a bitmap (a server icon, a profile
     avatar, a pack thumbnail). One shared frame shape across every list means
     the images line up as a column even when their content does not. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_well" />
    <stroke
        android:width="@dimen/od_stroke_rule"
        android:color="@color/od_well_edge" />
    <corners android:radius="@dimen/od_radius_avatar" />
</shape>
