<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — a dense settings/quick row: raised surface, hairline, 10dp radius. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ox_ember_soft">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/ox_surface" />
            <stroke android:width="1dp" android:color="@color/ox_hairline" />
        </shape>
    </item>
</ripple>
