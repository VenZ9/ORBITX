<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — the RESTING settings chip: hairline pill, no fill. The active one
     is the filled ember pill, so the two states differ by fill AND hue. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ox_ember_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/ox_hairline_strong" />
        </shape>
    </item>
</ripple>
