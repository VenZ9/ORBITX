<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-cap beam progress: purple gradient fill over a graphite track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#2E1F20" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="#D87B83" android:endColor="#C05B63"
                    android:angle="0" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
