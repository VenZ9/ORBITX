<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT — the index chip that numbers a drawer action (01, 02, ...).
  A square with the sharp radius, hairline border, mono numeral inside.
  The squareness is deliberate: it reads as a keyed entry, not a badge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ox_surface_raised"/>
    <stroke android:width="1dp" android:color="@color/ox_hairline_strong"/>
    <corners android:radius="4dp"/>
</shape>
