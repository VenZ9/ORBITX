<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora preference card — deep glass, teal wake on press, 22dp radius. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2E62D99B">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#1A2B24" />
                    <stroke
                        android:width="1dp"
                        android:color="#4062D99B" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="315"
                        android:startColor="#2C1A1B"
                        android:endColor="#1B0F10" />
                    <stroke
                        android:width="1dp"
                        android:color="#3E2628" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>