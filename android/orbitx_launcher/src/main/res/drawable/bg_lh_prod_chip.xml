<?xml version="1.0" encoding="utf-8"?>
<!-- ORBITX — quick-tool chip on the Home product strip.
     Pressed state is a <selector> so the chip reacts with no Java ripple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#3A1A1A" />
            <stroke android:width="1dp" android:color="#66FF3B30" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#26191A" />
            <stroke android:width="1dp" android:color="#99FF3B30" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#1F1717" />
            <stroke android:width="1dp" android:color="#33FF6B6B" />
        </shape>
    </item>
</selector>
