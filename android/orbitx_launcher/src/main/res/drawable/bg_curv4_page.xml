<?xml version="1.0" encoding="utf-8"?>
<!-- Cursor Lab v4 — deep space page with aurora corner glows -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1B0B0B" android:centerColor="#301212" android:endColor="#140909"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:centerX="0.12" android:centerY="0.02"
                android:gradientRadius="330dp" android:startColor="#1FF14B56" android:endColor="#00F14B56"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:centerX="0.92" android:centerY="0.88"
                android:gradientRadius="390dp" android:startColor="#1FF46767" android:endColor="#00F46767"/>
        </shape>
    </item>
</layer-list>
