        <shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#382B2C" /></shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#493B3C" /></shape></clip>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#D8C9CA" /></shape></clip>
    </item>
</layer-list>
