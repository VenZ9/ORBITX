<?xml version="1.0" encoding="utf-8"?>
<!-- Profile hero backdrop — deep violet-grey glass with soft bottom fade. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#301717" android:centerColor="#1F1213" android:endColor="#180D0E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00000000" android:endColor="#66000000" />
        </shape>
    </item>
</layer-list>
