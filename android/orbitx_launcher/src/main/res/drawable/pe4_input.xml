<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora input: teal stroke on focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#160D0E" />
            <stroke android:width="1.4dp" android:color="#E0D4D5" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1E1213" />
            <stroke android:width="1dp" android:color="#3AE0D4D5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#160D0E" />
            <stroke android:width="1dp" android:color="#332425" />
        </shape>
    </item>
</selector>