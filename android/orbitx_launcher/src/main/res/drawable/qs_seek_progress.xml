<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="4dp" />
            <corners android:radius="2dp" />
            <solid android:color="#382B2C" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="4dp" />
                <corners android:radius="2dp" />
                <solid android:color="#493B3C" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="4dp" />
                <corners android:radius="2dp" />
                <gradient android:angle="0" android:startColor="#9C8A8B" android:endColor="#EFE6E7" />
            </shape>
        </clip>
    </item>
</layer-list>
