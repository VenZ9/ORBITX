<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — a floating panel (dialog / in-game command panel).
     The ONE surface in the app allowed a rim strong enough to read as a
     window edge, because it sits over content it must be told apart from. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_window" />
    <stroke android:width="1dp" android:color="@color/od_well_edge" />
    <corners android:radius="@dimen/od_radius_panel" />
</shape>
