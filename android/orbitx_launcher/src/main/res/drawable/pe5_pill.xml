<?xml version="1.0" encoding="utf-8"?><!-- Aurora pill: teal glow when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="135" android:startColor="#E0D4D5" android:endColor="#CBBCBD" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#2E2324" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#221415" />
            <stroke android:width="1dp" android:color="#3E2426" />
        </shape>
    </item>
</selector>