<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — a mono readout chip: build ids, counts, key hints.
     Reads as a keycap on a keyboard: inset, bordered, monospace inside. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_well" />
    <stroke android:width="1dp" android:color="@color/od_well_edge" />
    <corners android:radius="@dimen/od_radius_sharp" />
</shape>
