<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — an empty UPLOAD SLOT.

     A dashed drop target. The dashed rim is doing real work: it says "nothing
     is here yet and something belongs here", which a solid outline cannot say.
     This is the only dashed shape in the language, so it always means a slot. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_slot_fill" />
    <stroke
        android:width="@dimen/od_stroke_rule"
        android:color="@color/od_slot_dash"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
    <corners android:radius="@dimen/od_radius_inner" />
</shape>
