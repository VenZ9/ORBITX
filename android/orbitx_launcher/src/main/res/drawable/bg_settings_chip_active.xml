<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — the ACTIVE settings chip. Filled ember pill, white label.
     Was a teal-green gradient (#62D99B) — the last Aurora hue in the app and
     the one place a selected tab did not match the rest of the product. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ox_ember" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
