<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — a NAV STRIP destination.

     Rest: nothing drawn, so a bar full of destinations reads as a quiet strip.
     Active: a raised fill. The accent rule under the caption is a SEPARATE view
     (see od_nav_underline) so it can be sized to the label rather than to the
     whole column — which is what the design does.

     Note there is deliberately no bottom rule here. An earlier version of this
     drawable drew one, and pairing it with the explicit underline put two amber
     rules 8dp apart on the same column. One rule, one meaning. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/od_pane_raised" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
