<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — a 2dp progress rule. A LINE, not a pill: on a dense panel a
     fat rounded progress bar is the loudest thing on screen, which is wrong for
     something the user is not meant to watch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/od_rule" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/od_accent" />
            </shape>
        </clip>
    </item>
</layer-list>
