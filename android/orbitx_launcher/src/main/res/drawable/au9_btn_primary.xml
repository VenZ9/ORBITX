<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#493B3C" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#C4B5B6" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="12dp" /><gradient android:angle="0" android:startColor="#EFE6E7" android:endColor="#D8C9CA" /></shape>
    </item>
</selector>