<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2ED8C9CA">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient android:angle="0" android:startColor="#312525" android:endColor="#221919" />
                    <stroke android:width="1.5dp" android:color="#D8C9CA" />
                </shape>
            </item>
            <item android:right="-4dp" android:top="8dp" android:bottom="8dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
