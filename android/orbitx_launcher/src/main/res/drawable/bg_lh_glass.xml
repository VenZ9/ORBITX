<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT — the navigation rail container.

  A flat obsidian panel with one hairline border. No gradient, no inner sheen,
  no shadow: the rail is part of the page, not a card floating above it. That
  single decision is what stops the shell looking like a stack of widgets.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ox_obsidian" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/ox_hairline" />
</shape>
