<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora stat tile: small numbered tile under hero cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:startColor="#2E2021"
        android:endColor="#221718" />
    <stroke android:width="1dp" android:color="#402B2C" />
</shape>
