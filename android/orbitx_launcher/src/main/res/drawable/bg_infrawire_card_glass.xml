<?xml version="1.0" encoding="utf-8"?>
<!-- Premium glass card: deep space gradient, neon-blue hairline, 24dp corners -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#221B1B"
        android:centerColor="#191414"
        android:endColor="#0E0B0B" />
