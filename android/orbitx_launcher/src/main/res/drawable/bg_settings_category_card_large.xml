<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — large tappable settings group card. Ember ripple, flat surfaces. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ox_ember_soft">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/ox_ember" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ox_surface_raised" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/ox_ember" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ox_surface" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/ox_hairline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
