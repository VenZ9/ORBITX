<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — the player avatar frame.

     Slightly rounder than the generic icon well because a head render is read
     as a portrait, and paired with a live dot when the account is online. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_well" />
    <stroke
        android:width="@dimen/od_stroke_rule"
        android:color="@color/od_inner_row_edge" />
    <corners android:radius="@dimen/od_radius_avatar" />
</shape>
