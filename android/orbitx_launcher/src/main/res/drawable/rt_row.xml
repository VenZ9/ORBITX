<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#382223"
                android:endColor="#241818" />
            <stroke android:width="1.8dp" android:color="#F0E2E3" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3A2526" />
            <stroke android:width="1.2dp" android:color="#6A4A4C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#221616"
                android:endColor="#191010" />
            <stroke android:width="1.2dp" android:color="#362526" />
        </shape>
    </item>
</selector>
