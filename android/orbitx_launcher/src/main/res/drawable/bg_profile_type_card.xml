<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — profile-type card: raised surface, hairline, subtle ember ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ox_ember_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ox_surface_raised" />
            <stroke android:width="1dp" android:color="@color/ox_hairline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
