<?xml version="1.0" encoding="utf-8"?>
<!-- OrbitX Client graphite row: list rows / manifest entries. Silver ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2ED8C9CA">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#241C1C" android:endColor="#1C1515" />
            <stroke android:width="1dp" android:color="#362A2A" />
        </shape>
    </item>
</ripple>
