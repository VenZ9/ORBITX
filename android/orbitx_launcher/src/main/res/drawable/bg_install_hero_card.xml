<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card for the install page: subtle lift with silver hairline -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#201919"
        android:centerColor="#1B1515"
        android:endColor="#191414"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#352D2D" />
    <corners android:radius="22dp" />
</shape>
