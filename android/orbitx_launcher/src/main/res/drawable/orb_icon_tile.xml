<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — icon tile used on drawer rows: square, hairline, no fill lift. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ox_surface"/>
    <stroke android:width="1dp" android:color="@color/ox_hairline"/>
    <corners android:radius="6dp"/>
</shape>
