<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora settings row — glass outline, teal glow on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2E62D99B">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#1B2A24"
                        android:centerColor="#261516"
                        android:endColor="#1B1011" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#4062D99B" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#241617"
                        android:centerColor="#1D1112"
                        android:endColor="#150C0D" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#402426" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>