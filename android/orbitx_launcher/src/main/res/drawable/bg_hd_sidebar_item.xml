<?xml version="1.0" encoding="utf-8"?>
<!--
  ORBIT — navigation rail item.

  REST     bare tile, nothing drawn. The rail is not a row of buttons; it is a
           column of positions. Only one of them is ever "on".
  PRESSED  a flat ember wash, no lift.
  SELECTED the tile gains a raised fill, a 1dp ember rim and an ember spine
           running down its outer edge. Selection is therefore carried by
           shape and position as well as hue, which survives a washed-out
           panel and reads for colour-blind users.

  There are no gradients-as-decoration and no shadows: the whole rail is flat
  colour plus hairlines.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ox_surface_raised" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/ox_ember" />
                </shape>
            </item>
            <!-- outer-edge spine: a soft ember wash bleeding in from the rail's
                 outer border. Size-independent, so it needs no dp math. -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="#66FF3B30"
                        android:centerColor="#1AFF3B30"
                        android:endColor="#00FF3B30" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ox_ember_soft" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/ox_hairline_strong" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
