<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — the live indicator: an ember ring with a hollow core. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ox_ember_soft"/>
        </shape>
    </item>
    <item android:bottom="4dp" android:top="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/ox_ember"/>
        </shape>
    </item>
</layer-list>
