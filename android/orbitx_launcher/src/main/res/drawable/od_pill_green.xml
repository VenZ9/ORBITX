<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — GREEN status pill. Online / ready.
     Green is semantic here: it is never used as identity, only as state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_pill_green_wash" />
    <stroke
        android:width="@dimen/od_stroke_rule"
        android:color="@color/od_pill_green" />
    <corners android:radius="@dimen/od_radius_pill" />
</shape>
