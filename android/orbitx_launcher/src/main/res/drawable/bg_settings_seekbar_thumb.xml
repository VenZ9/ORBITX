<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CONTROL EDITOR SLIDER — thumb (ORBITX platinum)
     28dp grab target. Idle: soft halo + platinum ring + white core.
     Pressed: halo brightens and thickens so the grab state is obvious.
     ═══════════════════════════════════════════════════════════════════ -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESSED / DRAGGING -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- glowing halo -->
            <item>
                <shape android:shape="oval">
                    <size android:width="28dp" android:height="28dp" />
                    <solid android:color="#40FFFFFF" />
                </shape>
            </item>
            <!-- platinum ring -->
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FAF6F6"
                        android:endColor="#D8C9CA" />
                </shape>
            </item>
            <!-- dark pupil -->
            <item android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp">
                <shape android:shape="oval">
                    <solid android:color="#1A1414" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- IDLE -->
    <item>
        <layer-list>
            <!-- soft halo -->
            <item>
                <shape android:shape="oval">
                    <size android:width="28dp" android:height="28dp" />
                    <solid android:color="#1FFFFFFF" />
                </shape>
            </item>
            <!-- platinum ring -->
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FAF6F6"
                        android:endColor="#D8C9CA" />
                </shape>
            </item>
            <!-- dark pupil -->
            <item android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp">
                <shape android:shape="oval">
                    <solid android:color="#1A1414" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
