<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — the search field in a toolbar. A well, so it recesses into
     the toolbar rather than floating on it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/od_well" />
    <stroke android:width="1dp" android:color="@color/od_well_edge" />
    <corners android:radius="@dimen/od_radius_sharp" />
</shape>
