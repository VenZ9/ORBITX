<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora settings deck row — deep glass card, teal-wash top light, 22dp radius. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2EFF3B30">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="#332021" android:endColor="#221516" />
                    <stroke android:width="1.2dp" android:color="#FF3B30" />
                </shape>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="22dp" />
                            <gradient android:angle="270" android:startColor="#2B1A1B" android:endColor="#1C1011" />
                            <stroke android:width="1dp" android:color="#3B2627" />
                        </shape>
                    </item>
                    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="26dp">
                        <shape android:shape="rectangle">
                            <corners android:topLeftRadius="21dp" android:topRightRadius="21dp" />
                            <gradient android:angle="270" android:startColor="#0DFF3B30" android:endColor="#00FF3B30" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>