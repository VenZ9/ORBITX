<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — a pane header strip: the label row that names a column set
     or a pane, closed by a rule. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/od_pane" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/od_rule_strong" />
        </shape>
    </item>
</layer-list>
