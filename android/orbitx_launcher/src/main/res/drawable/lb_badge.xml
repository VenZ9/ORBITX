<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#493B3C" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="315" android:startColor="#271E1E" android:centerColor="#1D1616" android:endColor="#151010" />
        </shape>
    </item>
</layer-list>