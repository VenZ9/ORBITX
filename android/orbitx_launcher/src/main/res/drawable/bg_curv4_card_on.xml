<?xml version="1.0" encoding="utf-8"?>
<!-- Selected card: gradient border frame + ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2EFFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient android:angle="0" android:startColor="#F14B56" android:endColor="#F46767"/>
                </shape>
            </item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <solid android:color="#2A1010"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
