<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT — ghost/secondary button: hairline outline, ember wash on press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/ox_ember_soft" />
            <stroke android:width="1dp" android:color="@color/ox_ember" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/ox_hairline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/ox_hairline_strong" />
        </shape>
    </item>
</selector>
