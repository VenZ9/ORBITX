<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT Desktop — a category / filter chip in a toolbar.
     Off = outline only. On = ember wash + ember rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/od_accent_wash" />
            <stroke android:width="1dp" android:color="@color/od_accent" />
            <corners android:radius="@dimen/od_radius_sharp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/od_rule_strong" />
            <corners android:radius="@dimen/od_radius_sharp" />
        </shape>
    </item>
</selector>
