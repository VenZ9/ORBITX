<?xml version="1.0" encoding="utf-8"?>
<!--
  OrbitX Launcher - home screen.

  OrbitX UI modification (recorded in LICENSE-THIRD-PARTY.md).

  Restyled to the flat, single-column language of DroidBridge Launcher and
  HyperLauncher: one vertical column with the current instance as a card at the
  top, the secondary actions as a grid inside a scrolling middle band, and the
  primary Play action as the single dominant filled block pinned at the bottom.

  This replaces the earlier OrbitX composition, which kept upstream's two-column
  split (full-height action column against a right Play rail) and only re-ordered
  what was inside it.  Neither reference launcher uses a side rail or a two-column
  split on the main screen - they are a single column with one big action - so the
  split is gone rather than restyled.

  Every id referenced by MainMenuFragment is preserved so behaviour is identical.

  Quick actions sizing: the tiles were too small and too fiddly to scroll with a
  large thumb, so they are now 76dp tall (64dp for the full-width row) with 16dp
  side padding, a 30dp icon, a 13sp label and a 12dp gutter - every tile is a
  comfortable target well past Android's 48dp minimum.  All of those values come
  from the orbitx_tile_* tokens in orbitx_ui.xml, so the scale stays consistent.
  The band keeps android:layout_weight="1" so it absorbs all leftover height and
  the tile row stays a real scroll surface; the instance card (wrap_content) and
  the Play block (wrap_content) are never squeezed, and the ScrollView still
  clips rather than pushing them off a short screen.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbitx_surface"
    android:orientation="vertical"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:id="@+id/launcher_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/orbitx_space_lg"
        android:paddingTop="@dimen/orbitx_space_md"
        android:paddingEnd="@dimen/orbitx_space_lg"
        android:paddingBottom="@dimen/orbitx_space_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ============ Band 1: the current instance ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/orbitx_space_xs"
            android:layout_marginBottom="@dimen/orbitx_space_sm"
            android:letterSpacing="0.12"
            android:text="@string/orbitx_home_profile"
            android:textAllCaps="true"
            android:textColor="@color/orbitx_section_label"
            android:textSize="@dimen/orbitx_section_label"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/version"
                android:layout_width="0dp"
                android:layout_height="@dimen/_64sdp"
                android:background="@drawable/orbitx_row"
                app:layout_constraintEnd_toStartOf="@+id/manager_profile_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:ripple_for_relative="true">

                <ImageView
                    android:id="@+id/version_icon"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/orbitx_space_md"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_minecraft" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="@dimen/orbitx_space_md"
                    android:layout_toEndOf="@id/version_icon"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/version_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="start"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="@string/version_no_versions"
                        android:textColor="@color/orbitx_on_surface"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/version_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="start"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textColor="@color/orbitx_on_surface_variant"
                        android:textSize="@dimen/_11ssp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <ImageButton
                android:id="@+id/manager_profile_button"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/orbitx_space_sm"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/ic_setting"
                app:layout_constraintBottom_toBottomOf="@id/version"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/version" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/view_account"
            layout="@layout/view_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbitx_space_sm" />

        <!-- ============ Band 2: quick actions (the scrollable middle) ============ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/orbitx_space_md"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/orbitx_space_xs"
                    android:layout_marginBottom="@dimen/orbitx_space_sm"
                    android:letterSpacing="0.12"
                    android:text="@string/orbitx_home_shortcuts"
                    android:textAllCaps="true"
                    android:textColor="@color/orbitx_section_label"
                    android:textSize="@dimen/orbitx_section_label"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/about_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/orbitx_tile_height"
                        android:layout_marginEnd="@dimen/orbitx_tile_gutter"
                        android:layout_weight="1"
                        android:background="@drawable/orbitx_tile"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/orbitx_tile_padding_h"
                        app:ripple_for_relative="true">

                        <ImageView
                            android:id="@+id/about_icon"
                            android:layout_width="@dimen/orbitx_tile_icon"
                            android:layout_height="@dimen/orbitx_tile_icon"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:scaleX="0.93"
                            android:scaleY="0.93"
                            app:srcCompat="@drawable/ic_about"
                            app:tint="@color/orbitx_accent" />

                        <TextView
                            android:id="@+id/about_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/orbitx_tile_icon_gap"
                            android:layout_toEndOf="@id/about_icon"
                            android:maxLines="2"
                            android:textColor="@color/orbitx_on_surface"
                            android:textSize="@dimen/orbitx_tile_text" />

                    </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                    <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/custom_control_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/orbitx_tile_height"
                        android:layout_weight="1"
                        android:background="@drawable/orbitx_tile"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/orbitx_tile_padding_h"
                        app:ripple_for_relative="true">

                        <ImageView
                            android:id="@+id/custom_control_icon"
                            android:layout_width="@dimen/orbitx_tile_icon"
                            android:layout_height="@dimen/orbitx_tile_icon"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ic_menu_custom_controls"
                            app:tint="@color/orbitx_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/orbitx_tile_icon_gap"
                            android:layout_toEndOf="@id/custom_control_icon"
                            android:maxLines="2"
                            android:text="@string/custom_control_title"
                            android:textColor="@color/orbitx_on_surface"
                            android:textSize="@dimen/orbitx_tile_text" />

                    </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/orbitx_tile_gutter"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/open_main_dir_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/orbitx_tile_height"
                        android:layout_marginEnd="@dimen/orbitx_tile_gutter"
                        android:layout_weight="1"
                        android:background="@drawable/orbitx_tile"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/orbitx_tile_padding_h"
                        app:ripple_for_relative="true">

                        <ImageView
                            android:id="@+id/open_main_dir_icon"
                            android:layout_width="@dimen/orbitx_tile_icon"
                            android:layout_height="@dimen/orbitx_tile_icon"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ic_folder"
                            app:tint="@color/orbitx_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/orbitx_tile_icon_gap"
                            android:layout_toEndOf="@id/open_main_dir_icon"
                            android:maxLines="2"
                            android:text="@string/main_open_main_dir"
                            android:textColor="@color/orbitx_on_surface"
                            android:textSize="@dimen/orbitx_tile_text" />

                    </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                    <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/install_jar_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/orbitx_tile_height"
                        android:layout_weight="1"
                        android:background="@drawable/orbitx_tile"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/orbitx_tile_padding_h"
                        app:ripple_for_relative="true">

                        <ImageView
                            android:id="@+id/install_jar_icon"
                            android:layout_width="@dimen/orbitx_tile_icon"
                            android:layout_height="@dimen/orbitx_tile_icon"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ic_java"
                            app:tint="@color/orbitx_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/orbitx_tile_icon_gap"
                            android:layout_toEndOf="@id/install_jar_icon"
                            android:maxLines="2"
                            android:text="@string/main_install_jar_file"
                            android:textColor="@color/orbitx_on_surface"
                            android:textSize="@dimen/orbitx_tile_text" />

                    </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                </LinearLayout>

                <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/share_logs_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/orbitx_tile_height_wide"
                    android:layout_marginTop="@dimen/orbitx_tile_gutter"
                    android:background="@drawable/orbitx_tile"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/orbitx_tile_padding_h"
                    app:ripple_for_relative="true">

                    <ImageView
                        android:id="@+id/share_logs_icon"
                        android:layout_width="@dimen/orbitx_tile_icon"
                        android:layout_height="@dimen/orbitx_tile_icon"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_share"
                        app:tint="@color/orbitx_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/orbitx_tile_icon_gap"
                        android:layout_toEndOf="@id/share_logs_icon"
                        android:text="@string/main_share_logs"
                        android:textColor="@color/orbitx_on_surface"
                        android:textSize="@dimen/orbitx_tile_text" />

                </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ============ Band 3: the single dominant primary action ============ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/play_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbitx_space_md">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/play_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/play_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/orbitx_action_height"
                    android:background="@drawable/orbitx_action_button"
                    android:text="@string/main_launch"
                    android:textAllCaps="false"
                    android:textColor="@color/orbitx_on_accent"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
