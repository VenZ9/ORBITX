<?xml version="1.0" encoding="utf-8"?>
<!--
  OrbitX Launcher - RED palette, dark variant (values-night).

  Mirrors values/colors.xml with dark red surfaces: near-black red-plum
  backgrounds, deep-red header bars and the same Material red accents, so the
  launcher reads as OrbitX in both light and dark mode.
-->
<resources>
    <color name="black_or_white">#FFFFFF</color>

    <color name="background_app">#1A0A0A</color>
    <color name="background_app_error">#431A1A</color>
    <color name="background_overlay">#4A2020</color>
    <color name="background_status_bar">#B71C1C</color>
    <color name="background_menu_top">#7F0000</color>
    <color name="background_menu_top_error">#E62E0909</color>
    <color name="background_menu_element">#D32F2F</color>
    <color name="background_ripple_effect">#DCDCDC</color>

    <color name="button_background">#3A1414</color>
    <color name="button_background_selected">#5B1F1F</color>
    <color name="dialog_background">#2A1010</color>

    <color name="menu_bar">#5A2020</color>
    <color name="menu_overlay">#BE231010</color>
    <color name="menu_progress">#E53935</color>

    <color name="background_item">#BF2E1414</color>
    <color name="background_item_selected">#D8401A1A</color>
    <color name="background_item_disabled">#D8452828</color>
    <color name="background_sponsor_intermediate">#80BD6C2D</color>
    <color name="background_sponsor_advanced">#80B83C1F</color>

    <color name="edit_box_fill">#4A2020</color>
    <color name="edit_box_fill_selected">#632A2A</color>

    <color name="mod_category_fill">#804C4C4C</color>
    <color name="text_background_fill">#B3432323</color>

    <color name="settings_category">#FF5252</color>

    <color name="icon_color">#FFFFFF</color>

    <color name="primary_text">#FFFFFF</color>

    <color name="text_on_red">#FFFFFFFF</color>
    <color name="text_on_red_secondary">#FFFFCDD2</color>
</resources>
