<?xml version="1.0" encoding="utf-8"?>
<!-- OrbitX: the single dominant primary action - solid accent fill, no outline,
     large radius.  Pressed state darkens rather than scaling, matching the flat
     reference style's flat pressed highlight. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/orbitx_action_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/orbitx_action_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/orbitx_action_pressed" />
    <item android:drawable="@drawable/orbitx_action_normal" />
</selector>
