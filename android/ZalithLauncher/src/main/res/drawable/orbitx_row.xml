<?xml version="1.0" encoding="utf-8"?>
<!-- OrbitX: flat list row - used by the instance / version / settings lists.  The
     whole row is one outlined card with a large radius, which is how the flat
     reference launchers present a single-column list of instances. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/orbitx_card" />
    <item android:state_pressed="true" android:drawable="@drawable/orbitx_row_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/orbitx_row_pressed" />
    <item android:state_checked="true" android:drawable="@drawable/orbitx_row_pressed" />
    <item android:state_selected="true" android:drawable="@drawable/orbitx_row_pressed" />
    <item android:drawable="@drawable/orbitx_card_raised" />
</selector>
