<?xml version="1.0" encoding="utf-8"?>
<!-- OrbitX: quick-action tile - flat raised surface with the hairline outline and
     a pressed value step (no ripple ring), matching the flat reference style. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/orbitx_tile_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/orbitx_tile_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/orbitx_tile_pressed" />
    <item android:state_checked="true" android:drawable="@drawable/orbitx_tile_pressed" />
    <item android:state_selected="true" android:drawable="@drawable/orbitx_tile_pressed" />
    <item android:drawable="@drawable/orbitx_tile_normal" />
</selector>
